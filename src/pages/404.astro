---
import { getCollection } from 'astro:content';
import Basis from '../layouts/Basis.astro';
import Chevron from '../components/Chevron.astro';
import { pad } from '../lib/site';
import { paginaTitel } from '../lib/seo';

const sectoren = (await getCollection('sectoren')).sort((a, b) =>
  a.data.naam.localeCompare(b.data.naam, 'nl'),
);
---

<Basis
  titel={paginaTitel('Pagina niet gevonden')}
  description="Deze pagina bestaat niet of is verplaatst. Zoek verder via de sectoren of het volledige trainingsaanbod."
  niveau="basis"
  noindex={true}
>
  <section class="vier-nul-vier op-licht gloed raster-achtergrond">
    <div class="omhulsel binnen">
      <Chevron aantal={3} breedte="3rem" verloop={true} />
      <p class="bovenkop">Foutmelding 404</p>
      <h1 class="display">Deze pagina <br /><span class="verloopwoord">bestaat niet</span></h1>
      <p class="inleiding">
        De pagina is verplaatst, hernoemd of heeft nooit bestaan. Onderstaande
        wegen leiden wel ergens heen.
      </p>

      <div class="knoppen">
        <a href={pad('/')} class="knop">
          Naar de homepage
          <span class="pijl" aria-hidden="true">→</span>
        </a>
        <a href={pad('/trainingen/')} class="knop knop-tweede">Alle trainingen</a>
      </div>

      <nav class="sectorwegen" aria-label="Sectoren">
        <p class="etiket">Of kies een sector</p>
        <ul>
          {sectoren.map((s) => (
            <li><a href={pad(`/sectoren/${s.data.slug}/`)}>{s.data.naam}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
</Basis>

<style>
  .vier-nul-vier {
    background: var(--mist-50);
    min-height: 70vh;
    display: grid;
    align-items: center;
    padding-block: clamp(3rem, 2rem + 5vw, 6rem);
  }
  .binnen { display: grid; gap: 1.15rem; justify-items: start; }
  .knoppen { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.4rem; }

  .sectorwegen {
    width: 100%;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rand-licht);
  }
  .etiket {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tekst-donker-zacht);
    margin-bottom: 0.9rem;
  }
  .sectorwegen ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .sectorwegen a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--rand-licht);
    border-radius: 999px;
    color: var(--tekst-donker-zacht);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 160ms, border-color 160ms, transform 160ms;
  }
  .sectorwegen a:hover {
    color: var(--oranje-op-wit);
    border-color: var(--oranje-500);
    transform: translateY(-1px);
  }
</style>

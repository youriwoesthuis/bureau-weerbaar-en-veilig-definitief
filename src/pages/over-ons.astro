---
import { getCollection } from 'astro:content';
import Basis from '../layouts/Basis.astro';
import Kruimels from '../components/Kruimels.astro';
import Cijferstrip from '../components/Cijferstrip.astro';
import Cta from '../components/Cta.astro';
import { SITE, pad } from '../lib/site';
import { paginaTitel, description } from '../lib/seo';

const [team, trainingen, beroepsgroepen, sectoren] = await Promise.all([
  getCollection('team'),
  getCollection('trainingen'),
  getCollection('beroepsgroepen'),
  getCollection('sectoren'),
]);

const leden = team
  .sort((a, b) => a.data.volgorde - b.data.volgorde)
  .map((lid) => ({ id: lid.id, data: lid.data }));

// Er is nog geen fotografie. In plaats van een lege plek die op een foto
// wacht, krijgt elk teamlid een initiaaltegel in een van de merkkleuren.
const initialen = (naam: string) =>
  naam
    .split(/\s+/)
    .filter((w) => w.length > 2 || /^[A-Z]/.test(w))
    .slice(0, 2)
    .map((w) => w[0])
    .join('')
    .toUpperCase();

const niveaus = ['basis', 'gevorderd', 'expert'] as const;

const kruimels = [
  { naam: 'Home', url: pad('/') },
  { naam: 'Over ons', url: pad('/over-ons/') },
];

const openingsantwoord = `Bureau Weerbaar en Veilig is een Nederlands trainingsbureau dat uitsluitend agressietraining verzorgt, vanuit ${SITE.adres.plaats} in ${SITE.adres.provincie}. Je traint met trainers die dit werk zelf doen, en bij elke training speelt een trainingsacteur mee. Bureau Weerbaar en Veilig is een handelsnaam binnen dezelfde onderneming als Act in Move Training & Coaching.`;

// Uit de rollen in de content geteld, niet met de hand ingevuld. Zes van de
// Hier stonden vier getallen: teamleden, acteurs, beroepsgroepen en
// trainingen. Aantallen noemen we niet meer, en "6 van de 12 zijn acteur"
// hoeft ook niet zo expliciet — het zijn gewoon teamleden.
// Zie BESLUITEN.md hoofdstuk 3.
const cijfers = [
  { waarde: 'Alleen', label: 'agressietraining, geen bijvak' },
  { waarde: 'Drie', label: 'niveaus om in door te groeien' },
  { waarde: 'Altijd', label: 'een trainingsacteur erbij' },
  { waarde: 'Overal', label: 'bij jullie op locatie, heel Nederland' },
];
---

<Basis
  titel={paginaTitel('Over Bureau Weerbaar en Veilig')}
  description={description(openingsantwoord)}
  niveau="gevorderd"
  kruimels={kruimels}
>
  <section class="kop-sectie op-licht gloed raster-achtergrond">
    <div class="omhulsel kop-binnen">
      <Kruimels kruimels={kruimels} />
      <p class="bovenkop">Over ons</p>
      <h1 class="display">Eén onderwerp,<br /><span class="verloopwoord">geen bijvak</span></h1>
      <p class="openingsantwoord">{openingsantwoord}</p>
    </div>
  </section>

  <section class="sectie-krap op-wit">
    <div class="omhulsel"><Cijferstrip cijfers={cijfers} /></div>
  </section>

  <section class="sectie op-licht">
    <div class="omhulsel twee-kolom">
      <div class="kop-blok">
        <p class="bovenkop">Waarom een apart bureau</p>
        <h2>De specialist naast de generalist</h2>
      </div>
      <div class="leestekst">
        <p>
          Bureau Weerbaar en Veilig is opgericht om één ding heel goed te doen.
          Agressie op de werkvloer is geen onderwerp dat je in een middag
          afhandelt binnen een bredere communicatietraining. Het vraagt om
          kennis van de beroepsgroep, van de situaties die daar voorkomen, en
          van wat er wettelijk en organisatorisch omheen hoort.
        </p>
        <p>
          Daarom delen we het aanbod niet in op werkvorm of thema, maar op
          <strong>beroepsgroep en niveau</strong>. Een wijkverpleegkundige die
          alleen in een woonkamer staat heeft een ander probleem dan een
          conducteur op een perron of een baliemedewerker bij de gemeente. Die
          verschillen zijn niet cosmetisch, en de trainingen zijn er ook niet
          naar geschreven.
        </p>
        <p>
          Bureau Weerbaar en Veilig is een handelsnaam binnen dezelfde
          onderneming als <a href="https://actinmove.nl" rel="noopener">Act in Move
          Training &amp; Coaching</a>, dat communicatiebreed traint, en
          <a href="https://agressievisie.nl" rel="noopener">AgressieVisie</a>, dat
          kennis over agressie verzamelt en deelt. Wie een training zoekt die
          niet over agressie gaat, is bij Act in Move aan het juiste adres.
        </p>
      </div>
    </div>
  </section>

  <section class="sectie op-wit">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">Het team</p>
        <h2>Wie de training geeft</h2>
        <p class="inleiding">
          Bij een agressietraining staat er altijd een trainer én een
          trainingsacteur. Die acteur is onderdeel van het team, geen
          ingehuurde kracht.
        </p>
      </div>

      {/* Alleen foto en naam; het verhaal staat op een eigen pagina onder
          /team/ — uitklappen in het raster oogde rommelig (Youri,
          31-08-2026). De achtergrond van de foto's is in de merkkleuren
          gezet met scripts/team-foto.mjs. */}
      <div class="teamlijst">
        {leden.map((lid, i) => (
          <a class="teamlid onthul" href={pad(`/team/${lid.id}/`)} data-niveau={niveaus[i % 3]}>
            {lid.data.foto ? (
              <img
                class="portret"
                src={pad(lid.data.foto.src)}
                alt={lid.data.foto.alt}
                width="750"
                height="1000"
                loading="lazy"
              />
            ) : (
              <span class="tegel" aria-hidden="true">{initialen(lid.data.naam)}</span>
            )}
            <span class="teamlid-naam">{lid.data.naam}</span>
            <span class="teamlid-hint" aria-hidden="true"></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sectie op-licht">
    <div class="omhulsel twee-kolom">
      <div class="kop-blok">
        <p class="bovenkop">Praktisch</p>
        <h2>Waar je ons vindt</h2>
      </div>
      <div class="leestekst">
        <p>
          Bureau Weerbaar en Veilig traint in heel Nederland, altijd
          incompany: bij jullie op locatie, met casuïstiek uit de
          eigen praktijk.
        </p>
        <address class="adresblok">
          <strong>{SITE.naam}</strong><br />
          {SITE.adres.straat}<br />
          {SITE.adres.postcode} {SITE.adres.plaats}<br />
          <a href={`tel:${SITE.telefoonUri}`}>{SITE.telefoon}</a><br />
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
          <span class="tijden">{SITE.openingstijden}</span>
        </address>
      </div>
    </div>
  </section>

  <Cta />
</Basis>

<style>
  .kop-sectie {
    background: var(--mist-50);
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) clamp(3rem, 2rem + 4vw, 5.5rem);
  }
  .kop-binnen { display: grid; gap: 1.25rem; justify-items: start; }

  .twee-kolom {
    display: grid;
    gap: clamp(1.5rem, 1rem + 2.5vw, 3.5rem);
    align-items: start;
  }
  @media (min-width: 900px) { .twee-kolom { grid-template-columns: minmax(0, 20rem) minmax(0, 1fr); } }
  .twee-kolom .kop-blok { margin-bottom: 0; }

  .teamlijst {
    display: grid;
    gap: clamp(0.85rem, 0.6rem + 1vw, 1.25rem);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10.5rem), 1fr));
    align-items: start;
  }

  .teamlid {
    display: grid;
    gap: 0.55rem;
    padding-bottom: 0.9rem;
    background: var(--wit);
    border: 1px solid var(--rand-licht);
    border-radius: var(--hoek);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 180ms, box-shadow 180ms, transform 180ms;
  }
  .teamlid:hover {
    border-color: var(--oranje-op-wit);
  }
  .teamlid:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }

  .portret {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
  }

  .tegel {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 3 / 4;
    background: color-mix(in oklab, var(--niveau-op-wit) 14%, var(--mist-100));
    color: var(--niveau-op-wit);
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 1.6rem;
    font-weight: 700;
  }

  .teamlid-naam {
    font-family: 'Manrope', system-ui, sans-serif;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.01em;
    color: var(--tekst-donker);
    text-align: center;
    padding-inline: 0.5rem;
  }

  .teamlid-hint {
    justify-self: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    border: 1px solid var(--rand-licht);
    color: var(--tekst-donker-zacht);
    display: grid;
    place-items: center;
    font-size: 0.9rem;
    line-height: 1;
    transition: background 180ms, color 180ms, border-color 180ms;
  }
  .teamlid-hint::before { content: '\2192'; }
  .teamlid:hover .teamlid-hint {
    background: var(--oranje-op-wit);
    border-color: var(--oranje-op-wit);
    color: var(--wit);
  }

  @media (prefers-reduced-motion: reduce) {
    .teamlid, .teamlid-hint { transition: none; }
    .teamlid:hover { transform: none; }
  }

  .adresblok {
    font-style: normal;
    margin-top: 1.5rem;
    padding-left: 1.1rem;
    border-left: 3px solid var(--oranje-op-wit);
    line-height: 1.8;
  }
  .adresblok strong { font-family: 'Manrope', system-ui, sans-serif; }
  .tijden { color: var(--tekst-donker-zacht); font-size: 0.9rem; }
</style>

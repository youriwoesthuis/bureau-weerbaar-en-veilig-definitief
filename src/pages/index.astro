---
import { getCollection } from 'astro:content';
import Basis from '../layouts/Basis.astro';
import Icoon from '../components/Icoon.astro';
import HeroBeeld from '../components/HeroBeeld.astro';
import Cijferstrip from '../components/Cijferstrip.astro';
import Pdca from '../components/Pdca.astro';
import Keuzehulp from '../components/Keuzehulp.astro';
import BeroepsgroepIndex from '../components/BeroepsgroepIndex.astro';
import NiveauLadder from '../components/NiveauLadder.astro';
import Cta from '../components/Cta.astro';
import { SITE, FEITEN, pad } from '../lib/site';
import { paginaTitel, description } from '../lib/seo';

const trainingen = await getCollection('trainingen');
const beroepsgroepen = await getCollection('beroepsgroepen');
const sectoren = await getCollection('sectoren');
const team = await getCollection('team');

// Alle cijfers geteld uit de content, nooit met de hand ingevuld.
const cijfers = [
  { waarde: trainingen.length, label: 'Trainingen', url: pad('/trainingen/') },
  { waarde: beroepsgroepen.length, label: 'Beroepsgroepen', url: pad('/sectoren/') },
  { waarde: sectoren.length, label: 'Sectoren', url: pad('/sectoren/') },
  { waarde: 3, label: 'Niveaus', url: pad('/niveaus/') },
];

const openingsantwoord = `Bureau Weerbaar en Veilig is een trainingsbureau dat uitsluitend agressietraining verzorgt. Het aanbod is opgebouwd per beroepsgroep — ${beroepsgroepen.length} in totaal, verdeeld over ${sectoren.length} sectoren — en elk daarvan in de niveaus basis, gevorderd en expert. Elke training duurt ${FEITEN.duur} en telt ${FEITEN.groepsgrootte}.`;

const verschillen = [
  {
    icoon: 'signaleren' as const,
    niveau: 'basis',
    kop: 'Eén onderwerp, geen bijvak',
    tekst:
      'Bureau Weerbaar en Veilig doet agressietraining en verder niets. Geen brede communicatietraining waar agressie een module in is.',
  },
  {
    icoon: 'team' as const,
    niveau: 'gevorderd',
    kop: 'Geschreven voor uw beroep',
    tekst:
      'Een wijkverpleegkundige alleen in een woonkamer heeft een ander probleem dan een conducteur op een perron. Daarom één training per beroepsgroep.',
  },
  {
    icoon: 'oefenen' as const,
    niveau: 'expert',
    kop: 'Oefenen met trainingsacteurs',
    tekst:
      'De situaties komen uit de praktijk van de deelnemers zelf. Er wordt geoefend tot het gedrag zit, niet tot de theorie is uitgelegd.',
  },
  {
    icoon: 'ladder' as const,
    niveau: 'basis',
    kop: 'Drie niveaus die op elkaar staan',
    tekst:
      'Van herkennen en de-escaleren, via begrenzen onder druk, naar beleid en teamnorm. Een team kan meegroeien.',
  },
];

const ingangen = [
  {
    icoon: 'telefoon' as const,
    niveau: 'basis',
    kop: 'Er is net iets gebeurd',
    tekst: 'Een incident, en het team moet verder. Bel gerust; we denken mee over wat er nu nodig is — ook als dat geen training is.',
    link: pad('/contact/'),
    linktekst: 'Neem contact op',
  },
  {
    icoon: 'ladder' as const,
    niveau: 'gevorderd',
    kop: 'We willen structureel trainen',
    tekst: 'Geen losse dag maar een lijn: kies de beroepsgroep en zie welke drie niveaus daarbij horen.',
    link: pad('/sectoren/'),
    linktekst: 'Kies uw beroepsgroep',
  },
  {
    icoon: 'beleid' as const,
    niveau: 'expert',
    kop: 'Ik moet beleid vastleggen',
    tekst: 'Teamnorm, meldingsbereidheid, nazorg en borging. Dat is waar niveau expert over gaat.',
    link: pad('/niveaus/expert/'),
    linktekst: 'Bekijk niveau expert',
  },
  {
    icoon: 'vinkje' as const,
    niveau: 'basis',
    kop: 'Ik weet niet welk niveau past',
    tekst: 'Drie vragen over het team en de aanleiding, en u weet welke richting het op gaat.',
    link: '#niveauhulp',
    linktekst: 'Naar de keuzehulp',
  },
];

const praktisch = [
  { icoon: 'klok' as const, kop: FEITEN.duur, tekst: 'per training, alle niveaus' },
  { icoon: 'groep' as const, kop: 'Max. 10', tekst: 'deelnemers, bij expert acht' },
  { icoon: 'locatie' as const, kop: 'Incompany', tekst: 'op uw locatie of in Neede' },
  { icoon: 'certificaat' as const, kop: 'Certificaat', tekst: 'deelnamebewijs na afloop' },
];
---

<Basis
  titel={paginaTitel('Agressietraining per beroepsgroep en niveau')}
  description={description(
    `Bureau Weerbaar en Veilig verzorgt agressietraining voor ${beroepsgroepen.length} beroepsgroepen in ${sectoren.length} sectoren, in drie niveaus. Incompany, ${FEITEN.duur}, ${FEITEN.groepsgrootte}.`,
  )}
  niveau="basis"
  kruimels={[{ naam: 'Home', url: pad('/') }]}
>
  <!-- ---------------- Hero ---------------- -->
  <section class="hero">
    <div class="omhulsel hero-raster">
      <div class="hero-tekst">
        <p class="bovenkop">{SITE.slogan}</p>
        <h1 class="display hero-kop">
          Agressietraining voor<br />
          <span class="verloopwoord">uw beroepsgroep</span>
        </h1>
        <p class="inleiding hero-inleiding">
          Geen algemene weerbaarheidscursus, maar de situaties die in uw werk
          daadwerkelijk voorkomen. {beroepsgroepen.length} beroepsgroepen,
          {sectoren.length} sectoren, elk in drie niveaus.
        </p>
        <div class="hero-knoppen">
          <a href="#kiezen" class="knop">
            Vind de training voor uw team
            <span class="pijl" aria-hidden="true">→</span>
          </a>
          <a href={pad('/aanpak/')} class="knop knop-tweede">Zo werken wij</a>
        </div>
      </div>

      <div class="hero-beeld"><HeroBeeld /></div>
    </div>

    <!-- De cijferstrip valt over de onderrand van de hero heen, zoals op
         agressievisie.nl. Dat bindt het donkere en het lichte vlak aan
         elkaar in plaats van ze hard op elkaar te laten stoten. -->
    <div class="omhulsel">
      <Cijferstrip cijfers={cijfers} overlappend={true} />
    </div>
  </section>

  <!-- ---------------- Openingsantwoord ---------------- -->
  <section class="sectie-krap op-licht na-hero">
    <div class="omhulsel">
      <p class="openingsantwoord">{openingsantwoord}</p>
    </div>
  </section>



  <!-- ---------------- Waar wil je beginnen ---------------- -->
  <section class="sectie op-licht">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">Waar wilt u beginnen?</p>
        <h2>Wat speelt er nu bij u?</h2>
        <p class="inleiding">
          Vier ingangen naar wat u op dit moment nodig hebt, zonder eerst het
          hele aanbod door te hoeven.
        </p>
      </div>
      <div class="rooster rooster-4">
        {ingangen.map((i) => (
          <a href={i.link} class="kaart onthul" data-niveau={i.niveau}>
            <span class="kaart-icoon"><Icoon naam={i.icoon} /></span>
            <h3>{i.kop}</h3>
            <p>{i.tekst}</p>
            <span class="pijllink kaart-voet">
              {i.linktekst}
              <span class="pijl" aria-hidden="true">→</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ---------------- Wie wij zijn ---------------- -->
  <section class="sectie op-licht">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">Wie wij zijn</p>
        <h2>Eén onderwerp, tot op de bodem</h2>
      </div>
      <div class="rooster rooster-3 wie-rooster">
        <article class="wie-blok">
          <span class="kaart-icoon"><Icoon naam="team" /></span>
          <h3>Wie</h3>
          <p>
            Bureau Weerbaar en Veilig is een Nederlands trainingsbureau met
            {team.length} trainers en coaches, gevestigd in {SITE.adres.plaats}
            en werkzaam door heel Nederland. Het is een handelsnaam binnen
            dezelfde onderneming als Act in Move Training &amp; Coaching.
          </p>
        </article>
        <article class="wie-blok">
          <span class="kaart-icoon"><Icoon naam="oefenen" /></span>
          <h3>Wat</h3>
          <p>
            Uitsluitend agressietraining. {trainingen.length} trainingen,
            geschreven voor {beroepsgroepen.length} afzonderlijke beroepsgroepen,
            elk in drie niveaus. Incompany, met casuïstiek uit de eigen praktijk
            van de deelnemers en waar nodig een trainingsacteur.
          </p>
        </article>
        <article class="wie-blok">
          <span class="kaart-icoon"><Icoon naam="grens" /></span>
          <h3>Waarom</h3>
          <p>
            Omdat een algemene weerbaarheidscursus niet werkt voor iemand die
            alleen in de woonkamer van een cliënt staat. Agressie is per beroep
            anders, dus de training hoort dat ook te zijn. Daarom is dit merk
            apart opgericht: één onderwerp, geen bijvak.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ---------------- De kiezer ---------------- -->
  <section class="sectie op-licht" id="kiezen">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">Direct naar uw vak</p>
        <h2>Welke beroepsgroep traint u?</h2>
        <p class="inleiding">
          Alle 44 beroepsgroepen die Bureau Weerbaar en Veilig traint, geordend
          per sector. Elke beroepsgroep heeft een eigen pagina met drie niveaus.
        </p>
      </div>
      <BeroepsgroepIndex />
    </div>
  </section>

  <!-- ---------------- De drie niveaus ---------------- -->
  <section class="sectie">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">Drie niveaus</p>
        <h2>Van herkennen tot beleid</h2>
        <p class="inleiding">
          De niveaus staan op elkaar. De kleur die u bij een training ziet,
          zegt om welk niveau het gaat — oranje, paars of diepblauw.
        </p>
      </div>
      <NiveauLadder />
      <p class="niveau-voet">
        <a href={pad('/niveaus/')} class="pijllink">
          Vergelijk de drie niveaus naast elkaar
          <span class="pijl" aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>



  <!-- ---------------- Niveau-keuzehulp ---------------- -->
  <section class="sectie op-licht" id="niveauhulp">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">Keuzehulp</p>
        <h2>Welk niveau past bij uw team?</h2>
        <p class="inleiding">
          Drie vragen. De uitkomst verschijnt meteen — er wordt niets
          verstuurd en u hoeft niets in te vullen.
        </p>
      </div>
      <Keuzehulp />
    </div>
  </section>

  <!-- ---------------- Onze werkwijze als cyclus ---------------- -->
  <section class="sectie">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">Hoe wij werken</p>
        <h2>Een training is geen dag, maar een stap</h2>
        <p class="inleiding">
          Bureau Weerbaar en Veilig werkt in de cyclus die u zelf ook gebruikt
          bij verbeteren: plan, do, check, act. Klik een fase aan om te zien
          wat er in die stap gebeurt.
        </p>
      </div>
      <Pdca />
    </div>
  </section>

  <!-- ---------------- Waarom dit bureau ---------------- -->
  <section class="sectie op-licht">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">Waarom Bureau Weerbaar en Veilig</p>
        <h2>Specialist, geen generalist</h2>
      </div>
      <div class="rooster rooster-4">
        {verschillen.map((v) => (
          <article class="kaart onthul" data-niveau={v.niveau}>
            <span class="kaart-icoon"><Icoon naam={v.icoon} /></span>
            <h3>{v.kop}</h3>
            <p>{v.tekst}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ---------------- Praktisch ---------------- -->
  <section class="sectie-krap">
    <div class="omhulsel">
      <div class="praktischrij">
        {praktisch.map((p) => (
          <div class="praktisch">
            <span class="praktisch-icoon"><Icoon naam={p.icoon} breedte={20} /></span>
            <span class="praktisch-tekst">
              <strong>{p.kop}</strong>
              <small>{p.tekst}</small>
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Cta />
</Basis>

<style>
  .hero {
    background: var(--inkt-900);
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) 0;
    position: relative;
    /* Bewust géén overflow: hidden. Dat knipte de cijferstrip af, die er
       juist met een negatieve marge overheen moet vallen. Het sfeerlicht
       hieronder blijft daarom zelf binnen de grenzen van de sectie. */
  }
  /* Zacht licht achter de illustratie, zodat het donkere vlak niet vlak oogt. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0 0 0 25%;
    background: radial-gradient(46% 52% at 62% 38%, rgba(241, 136, 22, 0.15) 0%, transparent 72%);
    pointer-events: none;
  }

  .hero-raster {
    display: grid;
    gap: clamp(2rem, 1rem + 4vw, 3rem);
    align-items: center;
    position: relative;
    z-index: 1;
  }
  @media (min-width: 900px) {
    /* minmax(0, …) is nodig: zonder die nul respecteert een fr-kolom de
       minimale inhoudsbreedte, en dan duwt de grote kop de illustratie
       weg tot een streepje van 238px. */
    .hero-raster { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); }
  }

  .hero-tekst { display: grid; gap: 1.35rem; justify-items: start; }
  .hero-kop { max-width: 16ch; }
  .verloopwoord {
    background: var(--verloop-tekst);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-inleiding { max-width: 34rem; }
  .hero-knoppen { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 0.4rem; }

  .hero-beeld { max-width: 26rem; margin-inline: auto; width: 100%; }
  @media (max-width: 899px) {
    .hero-beeld { max-width: 17rem; order: -1; }
  }

  /* Ruimte laten voor de strip die eroverheen valt. */
  .na-hero { padding-top: clamp(5.5rem, 4.5rem + 3vw, 7rem); }

  .kaart-voet { margin-top: auto; padding-top: 0.5rem; font-size: 0.9rem; }

  .wie-rooster { gap: clamp(1.25rem, 1rem + 1.5vw, 2.25rem); }
  .wie-blok { display: grid; gap: 0.6rem; align-content: start; }
  .wie-blok h3 { font-size: 1.2rem; }
  .wie-blok p { color: var(--tekst-donker-zacht); line-height: 1.6; }

  .niveau-voet { margin-top: clamp(1.25rem, 1rem + 1vw, 2rem); }

  /* ---- Praktische feitenrij ---- */
  .praktischrij {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: clamp(1rem, 0.8rem + 1vw, 1.75rem);
  }
  .praktisch { display: flex; align-items: center; gap: 0.85rem; }
  .praktisch-icoon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: none;
    border-radius: var(--hoek-klein);
    background: color-mix(in oklab, var(--oranje-500) 16%, transparent);
    color: var(--oranje-400);
  }
  .praktisch-tekst { display: grid; }
  .praktisch-tekst strong {
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .praktisch-tekst small { font-size: 0.85rem; color: var(--tekst-gedempt); }
</style>

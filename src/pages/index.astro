---
import { getCollection } from 'astro:content';
import Basis from '../layouts/Basis.astro';
import Icoon from '../components/Icoon.astro';
import HeroBeeld from '../components/HeroBeeld.astro';
import Niveaustrip from '../components/Niveaustrip.astro';
import Spanningscurve from '../components/Spanningscurve.astro';
import Vergelijker from '../components/Vergelijker.astro';
import Keuzehulp from '../components/Keuzehulp.astro';
import NiveauLadder from '../components/NiveauLadder.astro';
import Vragen from '../components/Vragen.astro';
import Cta from '../components/Cta.astro';
import { SITE, FEITEN, pad } from '../lib/site';
import { paginaTitel, description, faqSchema } from '../lib/seo';

const trainingen = await getCollection('trainingen');
const beroepsgroepen = await getCollection('beroepsgroepen');
const sectoren = await getCollection('sectoren');
const team = await getCollection('team');

// Hier stond een cijferstrip met vier catalogusgetallen. Die is vervangen
// door de niveaustrip; zie Niveaustrip.astro en BESLUITEN.md hoofdstuk 4.

// Eerste zin noemt de merknaam één keer, zodat een AI-antwoord de bron kan
// aanwijzen. Daarna "je". Zie BESLUITEN.md hoofdstuk 5.
const openingsantwoord = `Bureau Weerbaar en Veilig is een Nederlands trainingsbureau dat uitsluitend incompany agressietraining verzorgt, opgebouwd per beroepsgroep en in drie niveaus (de Weerbaarheidsladder). Je team traint met situaties uit het eigen werk, niet met algemene voorbeelden. Elke training duurt ${FEITEN.duur}, telt ${FEITEN.groepsgrootte} en wordt bij jullie op locatie gegeven, met een trainingsacteur erbij.`;

const homeVragen = [
  {
    vraag: 'Waarom geven jullie alleen incompany en geen open inschrijving?',
    antwoord:
      'Omdat een training wordt opgebouwd met de eigen situaties van het team. Bij een open inschrijving zit iedereen met een ander vak in de zaal en wordt het oefenmateriaal vanzelf algemeen. Op locatie oefen je in de ruimte waar het werk gebeurt, met de gesprekken die daar echt voorkomen.',
  },
  {
    vraag: 'Kunnen we een training laten aansluiten op iets dat net is gebeurd?',
    antwoord:
      'Ja. Wat er is gebeurd komt in de intake ter sprake en bepaalt mee waarmee er die dag geoefend wordt. De trainingsacteur speelt situaties na die het team zelf inbrengt, geen standaardscenario.',
  },
  {
    vraag: 'Onze mensen verschillen sterk in ervaring. Kan dat in één groep?',
    antwoord:
      'Meestal wel, en soms is het juist nuttig: wie het werk langer doet, brengt situaties in waar een nieuwe collega nog van schrikt. Loopt het te ver uiteen, dan is het beter de groep te splitsen of een ander niveau te kiezen. Dat weeg je in de intake.',
  },
  {
    vraag: 'Trainen jullie leidinggevenden apart van hun team?',
    antwoord:
      'Dat kan, en daar is het niveau expert voor. Dat gaat niet over het eigen gesprek maar over de organisatie eromheen: de teamnorm vaststellen, nazorg inrichten en borgen dat afspraken blijven staan. Basis en gevorderd zijn voor wie het werk zelf doet.',
  },
  {
    vraag: 'Wat gebeurt er nadat we contact hebben opgenomen?',
    antwoord:
      'Eerst een intake over wat er speelt, hoe vaak het voorkomt en wat er al ligt aan protocol en afspraken. Daarna bouwen de trainer en de trainingsacteur de dag op rond die situaties. De dag zelf eindigt met afspraken die het team zelf maakt.',
  },
];

const verschillen = [
  {
    icoon: 'signaleren' as const,
    niveau: 'basis',
    kop: 'Twee soorten agressie, twee reacties',
    tekst:
      'Wie schreeuwt uit boosheid over een besluit vraagt iets anders dan wie dreigt om een uitzondering af te dwingen. Bij frustratie werkt ruimte geven, bij druk zetten werkt een grens. De verkeerde keuze maakt het erger.',
  },
  {
    icoon: 'team' as const,
    niveau: 'gevorderd',
    kop: 'Geschreven voor jouw beroep',
    tekst:
      'Een wijkverpleegkundige alleen in een woonkamer heeft een ander probleem dan een conducteur op een perron: de een kan niemand roepen, de ander kan niet weg. Je oefent met de situaties van je eigen beroep.',
  },
  {
    icoon: 'oefenen' as const,
    niveau: 'expert',
    kop: 'Oefenen met trainingsacteurs',
    tekst:
      'De situaties komen uit de praktijk van de deelnemers zelf. Je oefent tot het gedrag zit, niet tot de theorie is uitgelegd.',
  },
  {
    icoon: 'ladder' as const,
    niveau: 'basis',
    kop: 'Drie niveaus die op elkaar staan',
    tekst:
      'Van herkennen en de-escaleren, via begrenzen onder druk, naar beleid en teamnorm. Een team kan meegroeien.',
  },
];

const ingangen = [
  {
    icoon: 'telefoon' as const,
    niveau: 'basis',
    kop: 'Er is net iets gebeurd',
    tekst: 'Een incident, en het team moet verder. Bel gerust; we denken mee over wat er nu nodig is, ook als dat geen training is.',
    link: pad('/contact/'),
    linktekst: 'Neem contact op',
  },
  {
    icoon: 'ladder' as const,
    niveau: 'gevorderd',
    kop: 'We willen structureel trainen',
    tekst: 'Geen losse dag maar een lijn: kies de beroepsgroep en zie welke drie niveaus daarbij horen.',
    link: pad('/sectoren/'),
    linktekst: 'Kies je beroepsgroep',
  },
  {
    icoon: 'beleid' as const,
    niveau: 'expert',
    kop: 'We moeten beleid vastleggen',
    tekst: 'Teamnorm, meldingsbereidheid, nazorg en borging. Dat is waar niveau expert over gaat.',
    link: pad('/niveaus/expert/'),
    linktekst: 'Bekijk niveau expert',
  },
  {
    icoon: 'vinkje' as const,
    niveau: 'basis',
    kop: 'Welk niveau past bij ons?',
    tekst: 'Drie vragen over het team en de aanleiding, en je weet welke richting het op gaat.',
    link: '#niveauhulp',
    linktekst: 'Naar de keuzehulp',
  },
];

// Korte weergave van de cyclus. De volledige, uitklapbare versie staat op
// /aanpak/ — die pagina gaat erover, dus daar hoort de uitleg. Hier alleen
// de vier stappen, zodat de homepage er niet mee gaat concurreren.
// De vier stops van het logoverloop, maar dan de varianten die op wit
// leesbaar zijn. De originele tinten (#f18816, #d99a6a, #c49bb0, #8fa2e6)
// zijn gekozen voor een bijna zwart vlak en halen als tekst op wit de
// 4,5:1 niet.
const cyclus = [
  { letter: 'P', naam: 'Plan', kort: 'Wat speelt er precies?', kleur: '#a45a0a' },
  { letter: 'D', naam: 'Do', kort: 'De trainingsdag', kleur: '#96551f' },
  { letter: 'C', naam: 'Check', kort: 'Wat werkt er op de werkvloer?', kleur: '#8d6078' },
  { letter: 'A', naam: 'Act', kort: 'Vastleggen en doorgroeien', kleur: '#4767cc' },
];



const praktisch = [
  { icoon: 'klok' as const, kop: FEITEN.duur, tekst: 'per training, alle niveaus' },
  { icoon: 'groep' as const, kop: 'Max. 10', tekst: 'deelnemers, bij expert acht' },
  { icoon: 'team' as const, kop: 'Acteur', tekst: 'speelt standaard mee' },
  { icoon: 'locatie' as const, kop: 'Incompany', tekst: 'altijd bij jullie op locatie' },
  { icoon: 'certificaat' as const, kop: 'Certificaat', tekst: 'deelnamebewijs na afloop' },
];
---

<Basis
  titel={paginaTitel('Incompany agressietraining per beroepsgroep')}
  description={description(
    `Bureau Weerbaar en Veilig verzorgt uitsluitend incompany agressietraining, per beroepsgroep en in drie niveaus. ${FEITEN.duur}, ${FEITEN.groepsgrootte}, trainingsacteur inbegrepen. Vraag een offerte aan.`,
  )}
  niveau="basis"
  kruimels={[{ naam: 'Home', url: pad('/') }]}
  schema={[faqSchema(homeVragen)].filter(Boolean)}
>
  <!-- ---------------- Hero ---------------- -->
  <section class="hero op-licht">
    <div class="omhulsel hero-raster">
      <div class="hero-tekst">
        <p class="bovenkop">{SITE.slogan}</p>
        <h1 class="display hero-kop">
          Agressie hoort niet bij het werk. <br />
          <span class="verloopwoord">Ermee omgaan wel.</span>
        </h1>
        <p class="inleiding hero-inleiding">
          Hoeveel ruimte je hebt als het misgaat, hangt af van waar je staat.
          Achter een balie kun je niet weg. In de woonkamer van een ander is er
          geen collega om de hoek. Daarom traint elk beroep hier met zijn eigen
          situaties, in drie niveaus, bij jullie op locatie.
        </p>
        <div class="hero-knoppen">
          <a href={pad('/sectoren/')} class="knop">
            Vind de training voor je team
            <span class="pijl" aria-hidden="true">→</span>
          </a>
          <a href={pad('/aanpak/')} class="knop knop-tweede">Zo werken wij</a>
        </div>
      </div>

      <div class="hero-beeld"><HeroBeeld /></div>
    </div>

    {/* De niveaustrip valt over de onderrand van de hero heen. Dat bindt het
        donkere en het lichte vlak aan elkaar in plaats van ze hard op elkaar te
        laten stoten. Deze toelichting stond eerder als HTML-comment en kwam dus
        in de gebouwde pagina terecht, inclusief de naam van een zustermerk. */}
    <div class="omhulsel">
      <Niveaustrip overlappend={true} />
    </div>
  </section>

  <section class="sectie-krap op-licht na-hero">
    <div class="omhulsel">
      <p class="openingsantwoord">{openingsantwoord}</p>
    </div>
  </section>

  <section class="sectie op-wit">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">Waar je staat bepaalt wat werkt</p>
        <h2>Dezelfde vaardigheid, vier keer iets anders</h2>
        <p class="inleiding">
          Drie dingen bepalen wat je kunt doen: of je weg kunt, of er iemand in
          de buurt is, en of je die ander volgende week weer ziet. Wie een
          cliënt maanden begeleidt, begrenst voorzichtiger dan wie een passant
          eenmalig spreekt, want de relatie moet erna nog werken. Vergelijk vier
          beroepen op die drie punten.
        </p>
      </div>
      <Vergelijker />
    </div>
  </section>

  <section class="sectie op-licht">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">Hoe deze trainingen in elkaar zitten</p>
        <h2>Waarom de ene reactie werkt en de andere niet</h2>
      </div>
      <div class="rooster rooster-4">
        {verschillen.map((v) => (
          <article class="kaart onthul" data-niveau={v.niveau}>
            <span class="kaart-icoon"><Icoon naam={v.icoon} /></span>
            <h3>{v.kop}</h3>
            <p>{v.tekst}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sectie op-wit">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">Het vak in één plaat</p>
        <h2>Hoe eerder je het ziet, hoe meer je kunt</h2>
        <p class="inleiding">
          Spanning loopt op in stappen, en bij elke stap werkt iets anders.
          Kies een fase om te zien wat je ziet, wat werkt en wat juist niet.
        </p>
      </div>
      <Spanningscurve />
    </div>
  </section>

  <section class="sectie op-wit">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">Drie niveaus</p>
        <h2>Van herkennen tot beleid</h2>
        <p class="inleiding">
          De niveaus staan op elkaar. De kleur die je bij een training ziet,
          zegt om welk niveau het gaat: oranje, paars of diepblauw.
        </p>
      </div>
      <NiveauLadder />
      <p class="niveau-voet">
        <a href={pad('/niveaus/')} class="pijllink">
          Vergelijk de drie niveaus naast elkaar
          <span class="pijl" aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>

  <section class="sectie op-licht" id="niveauhulp">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">Keuzehulp</p>
        <h2>Welk niveau past bij je team?</h2>
        <p class="inleiding">
          Drie vragen. De uitkomst verschijnt meteen: je vult niets in
          en er wordt niets verstuurd.
        </p>
      </div>
      <Keuzehulp />
    </div>
  </section>

  {/* Twee dingen die een inkoper nodig heeft voor hij belt: waarmee hij dit
      intern verantwoordt, en de zekerheid dat er geen rekening achteraan komt.
      Bewust geen "Arbo-compliant" en geen reactietermijn: de werkgever moet
      aan de wet voldoen, niet de training, en een termijn is nooit
      toegezegd. Zie BESLUITEN.md hoofdstuk 7i. */}
  <section class="sectie op-licht">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">Voor je het intern voorlegt</p>
        <h2>Waarmee je dit onderbouwt</h2>
      </div>
      <div class="rooster rooster-2">
        <article class="kaart onthul" data-niveau="expert">
          <h3>Het staat in je plan van aanpak</h3>
          <p>
            De Arbowet verplicht een werkgever beleid te voeren tegen
            psychosociale arbeidsbelasting, de risico’s vast te leggen in de
            RI&E en voorlichting en onderricht te geven. Een training is een
            van de maatregelen die je in dat plan kunt opnemen. Op elke
            beroepsgroeppagina staat een voorbeeldpassage die je kunt
            overnemen.
          </p>
          <a href={pad('/wet-en-regels/')} class="pijllink">
            Wat de wet precies vraagt
            <span class="pijl" aria-hidden="true">→</span>
          </a>
        </article>
        <article class="kaart onthul" data-niveau="gevorderd">
          <h3>Geen rekening achteraf</h3>
          <p>
            Eén bedrag, met de voorbereiding, de eigen casuïstiek en de
            trainingsacteur erin. De acteur is geen aparte post en geen optie
            tegen meerprijs. Wat de prijs wél bepaalt, staat er open bij: het
            aantal groepen, het niveau, de reisafstand en de omvang van het
            traject.
          </p>
          <a href={pad('/kosten/')} class="pijllink">
            Wat een training kost
            <span class="pijl" aria-hidden="true">→</span>
          </a>
        </article>
      </div>
    </div>
  </section>

  <section class="sectie op-wit">
    <div class="omhulsel">
      <Vragen vragen={homeVragen} kop="Vragen die vooraf spelen" groep="homevragen" />
    </div>
  </section>

  <section class="sectie-krap op-wit">
    <div class="omhulsel">
      <div class="praktischrij">
        {praktisch.map((p) => (
          <div class="praktisch">
            <span class="praktisch-icoon"><Icoon naam={p.icoon} breedte={20} /></span>
            <span class="praktisch-tekst">
              <strong>{p.kop}</strong>
              <small>{p.tekst}</small>
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Cta />
</Basis>

<style>

  .hero {
    background: var(--mist-50);
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) 0;
    position: relative;
    /* Bewust géén overflow: hidden. Dat knipte de cijferstrip af, die er
       juist met een negatieve marge overheen moet vallen. Het sfeerlicht
       hieronder blijft daarom zelf binnen de grenzen van de sectie. */
  }
  /* Hier stond een zacht oranje licht achter de illustratie. Uitgezet bij de
     designreview van 31-08-2026 — dezelfde reden als de gloed-klasse: geen
     pastelwaas op een site over agressie. */

  .hero-raster {
    display: grid;
    gap: clamp(2rem, 1rem + 4vw, 3rem);
    align-items: center;
    position: relative;
    z-index: 1;
  }
  @media (min-width: 900px) {
    /* minmax(0, …) is nodig: zonder die nul respecteert een fr-kolom de
       minimale inhoudsbreedte, en dan duwt de grote kop de illustratie
       weg tot een streepje van 238px. */
    .hero-raster { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); }
  }

  .hero-tekst { display: grid; gap: 1.35rem; justify-items: start; }
  .hero-kop { max-width: 16ch; }
  .hero-inleiding { max-width: 34rem; }
  .hero-knoppen { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 0.4rem; }

  .hero-beeld { max-width: 26rem; margin-inline: auto; width: 100%; }
  @media (max-width: 899px) {
    .hero-beeld { max-width: 17rem; order: -1; }
  }

  /* Ruimte laten voor de strip die eroverheen valt. */
  .na-hero { padding-top: clamp(5.5rem, 4.5rem + 3vw, 7rem); }

  .kaart-voet { margin-top: auto; padding-top: 0.5rem; font-size: 0.9rem; }

  .wie-rooster { gap: clamp(1.25rem, 1rem + 1.5vw, 2.25rem); }
  .wie-blok { display: grid; gap: 0.6rem; align-content: start; }
  .wie-blok h3 { font-size: 1.2rem; }
  .wie-blok p { color: var(--tekst-donker-zacht); line-height: 1.6; }

  .niveau-voet { margin-top: clamp(1.25rem, 1rem + 1vw, 2rem); }

  /* ---- Korte weergave van de PDCA-cyclus ----
     De volledige, uitklapbare versie staat op /aanpak/. Hier alleen de vier
     stappen als verwijzing, zodat de twee pagina's elkaar niet herhalen. */
  .cyclusstrip {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 1px;
    background: var(--rand-licht);
    border: 1px solid var(--rand-licht);
    border-radius: var(--hoek);
    overflow: hidden;
  }
  .cyclusstap {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1.1rem 1.2rem;
    background: var(--wit);
    border-top: 3px solid var(--fasekleur);
  }
  .cyclusletter {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    flex: none;
    border-radius: 50%;
    background: color-mix(in oklab, var(--fasekleur) 22%, transparent);
    color: var(--fasekleur);
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 0.95rem;
    font-weight: 800;
  }
  .cyclustekst { display: grid; gap: 0.1rem; min-width: 0; }
  .cyclustekst strong {
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .cyclustekst small { font-size: 0.85rem; color: var(--tekst-donker-zacht); line-height: 1.35; }

  /* ---- Praktische feitenrij ---- */
  .praktischrij {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: clamp(1rem, 0.8rem + 1vw, 1.75rem);
  }
  .praktisch { display: flex; align-items: center; gap: 0.85rem; }
  .praktisch-icoon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: none;
    border-radius: var(--hoek-klein);
    background: color-mix(in oklab, var(--oranje-500) 16%, transparent);
    color: var(--oranje-op-wit);
  }
  .praktisch-tekst { display: grid; }
  .praktisch-tekst strong {
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .praktisch-tekst small { font-size: 0.85rem; color: var(--tekst-donker-zacht); }
</style>

---
import { getCollection } from 'astro:content';
import Basis from '../layouts/Basis.astro';
import Kruimels from '../components/Kruimels.astro';
import Chevron from '../components/Chevron.astro';
import Vragen from '../components/Vragen.astro';
import { SITE, NIVEAUS, NIVEAU_INFO, FEITEN, pad } from '../lib/site';
import { paginaTitel, description, faqSchema } from '../lib/seo';

const [sectoren, beroepsgroepen] = await Promise.all([
  getCollection('sectoren'),
  getCollection('beroepsgroepen'),
]);

const groepen = beroepsgroepen
  .map((b) => ({
    naam: b.data.naam,
    slug: b.data.slug,
    sector: sectoren.find((s) => s.data.slug === b.data.sector)?.data.naam ?? b.data.sector,
  }))
  .sort((a, b) => a.sector.localeCompare(b.sector, 'nl') || a.naam.localeCompare(b.naam, 'nl'));

// Groeperen per sector voor de <optgroup> in het keuzemenu.
const perSector = [...new Set(groepen.map((g) => g.sector))].sort((a, b) => a.localeCompare(b, 'nl'));

/**
 * De verzenddienst wordt via een omgevingsvariabele ingesteld
 * (Web3Forms of Formspree). Zolang die niet is ingevuld, tonen we
 * bewust géén formulier: een knop die niets doet is erger dan geen knop.
 * Zie WERKWIJZE.md, hoofdstuk "Het contactformulier aanzetten".
 */
const formulierEndpoint = import.meta.env.PUBLIC_FORMULIER_ENDPOINT ?? '';
const formulierSleutel = import.meta.env.PUBLIC_FORMULIER_SLEUTEL ?? '';
const formulierActief = Boolean(formulierEndpoint);

const kruimels = [
  { naam: 'Home', url: pad('/') },
  { naam: 'Contact', url: pad('/contact/') },
];

const openingsantwoord = `Bureau Weerbaar en Veilig is bereikbaar op ${SITE.telefoon} en via ${SITE.email}, op ${SITE.openingstijden}. Het bureau is gevestigd aan de ${SITE.adres.straat} in ${SITE.adres.plaats} en verzorgt agressietraining door heel Nederland, altijd bij jullie op locatie.`;

/**
 * Zolang het formulier uit staat is mailen de belangrijkste route. Een lege
 * mail betekent dat de bezoeker zelf moet bedenken wat hij vertelt — en dan
 * komt er "graag informatie over agressietraining" binnen, waar niemand mee
 * verder kan. Met deze regels erin staat de aanvraag meteen compleet.
 *
 * De regels zijn precies de velden die het formulier ook zou uitvragen, in
 * dezelfde volgorde, zodat de overstap later niets verandert aan wat er
 * binnenkomt.
 */
const mailRegels = [
  'Organisatie:',
  'Beroepsgroep:',
  'Aantal deelnemers:',
  'Gewenst niveau (basis / gevorderd / expert, of nog onbekend):',
  '',
  'Wat speelt er?',
  '(Bijvoorbeeld: wat er is gebeurd, hoe vaak het voorkomt, en wat het team al heeft geprobeerd.)',
  '',
  '',
  'Met vriendelijke groet,',
  '',
];
const mailLink =
  `mailto:${SITE.email}` +
  `?subject=${encodeURIComponent('Aanvraag agressietraining')}` +
  `&body=${encodeURIComponent(mailRegels.join('\n'))}`;

/**
 * Vragen die over de aanvraag zelf gaan, niet over de inhoud van een
 * training — die staan per beroepsgroep en per sector. Alles hieronder
 * volgt uit FEITEN of uit wat elders op deze pagina al staat. Er staat
 * bewust geen reactietermijn en geen prijs in: die zijn niet vastgesteld.
 */
const contactVragen = [
  {
    vraag: 'Wat kost een agressietraining?',
    antwoord:
      'Er staat geen prijs op de site, omdat elke aanvraag anders is. Wat de prijs bepaalt: het aantal groepen, het niveau, de reisafstand en de omvang van het traject. De trainingsacteur niet — die speelt standaard mee. Vertel wat er speelt, dan komt daar een offerte op maat uit.',
  },
  {
    vraag: 'Werkt Bureau Weerbaar en Veilig door heel Nederland?',
    antwoord: `Ja. De trainingen worden ${FEITEN.locatie} gegeven, in heel Nederland. Het bureau is gevestigd in ${SITE.adres.plaats} (${SITE.adres.provincie}), maar daar wordt niet getraind.`,
  },
  {
    vraag: 'Wij hebben meer medewerkers dan er in één groep passen. Hoe werkt dat?',
    antwoord: `De groepsgrootte is ${FEITEN.groepsgrootte}, bij expert ${FEITEN.groepsgrootteExpert}. Een groter team wordt dus over meerdere groepen verdeeld. Hoe die verdeling loopt — per afdeling, per locatie of gemengd — bepalen we samen in de intake.`,
  },
  {
    vraag: 'Wij weten nog niet welk niveau we nodig hebben. Kunnen we toch contact opnemen?',
    antwoord:
      'Ja, en dat is normaal. Je kunt de niveau-keuzehulp op de homepagina gebruiken voor een eerste richting, maar het niveau vaststellen hoort bij de intake en niet bij de aanvraag.',
  },
  {
    vraag: 'Wat heeft Bureau Weerbaar en Veilig nodig om een aanvraag te kunnen beoordelen?',
    antwoord:
      'De beroepsgroep, het aantal deelnemers en een beschrijving van wat er speelt: wat er is gebeurd, hoe vaak het voorkomt en wat het team al heeft geprobeerd. Op basis daarvan wordt het niveau bepaald en de casuïstiek gekozen.',
  },
  {
    vraag: 'Kunnen medewerkers van verschillende afdelingen in één groep?',
    antwoord:
      'Dat kan, maar het aanbod is bewust per beroepsgroep opgebouwd omdat de situaties verschillen. Of een gemengde groep werkt, hangt af van hoeveel de deelnemers in de praktijk delen. Dat is een vraag voor de intake.',
  },
];

const schema = [faqSchema(contactVragen)].filter(Boolean);
---

<Basis
  titel={paginaTitel('Contact en offerte aanvragen')}
  description={description(openingsantwoord)}
  niveau="basis"
  kruimels={kruimels}
  schema={schema}
>
  <section class="kop-sectie op-licht gloed raster-achtergrond">
    <div class="omhulsel kop-binnen">
      <Kruimels kruimels={kruimels} />
      <p class="bovenkop">Contact</p>
      <h1 class="display">Vertel wat<br /><span class="verloopwoord">er speelt</span></h1>
      <p class="openingsantwoord">{openingsantwoord}</p>
    </div>
  </section>

  <section class="sectie op-wit">
    <div class="omhulsel contact-indeling">
      <!-- ---------- Formulier of directe gegevens ---------- -->
      <div class="formulierkant">
        {formulierActief ? (
          <form action={formulierEndpoint} method="POST" class="formulier">
            {formulierSleutel && <input type="hidden" name="access_key" value={formulierSleutel} />}
            <input type="hidden" name="subject" value="Aanvraag via bureauweerbaarenveilig.nl" />
            <input type="hidden" name="from_name" value={SITE.naam} />
            {/* Spamval: een veld dat mensen niet zien en bots wel invullen. */}
            <input type="checkbox" name="botcheck" class="botval" tabindex="-1" autocomplete="off" />

            <h2 class="h3">Offerte aanvragen</h2>

            <div class="veld">
              <label for="naam">Je naam <span class="verplicht">*</span></label>
              <input type="text" id="naam" name="naam" required autocomplete="name" />
            </div>

            <div class="veld-rij">
              <div class="veld">
                <label for="organisatie">Organisatie <span class="verplicht">*</span></label>
                <input type="text" id="organisatie" name="organisatie" required autocomplete="organization" />
              </div>
              <div class="veld">
                <label for="email">E-mailadres <span class="verplicht">*</span></label>
                <input type="email" id="email" name="email" required autocomplete="email" />
              </div>
            </div>

            <div class="veld-rij">
              <div class="veld">
                <label for="telefoon">Telefoonnummer</label>
                <input type="tel" id="telefoon" name="telefoon" autocomplete="tel" />
              </div>
              <div class="veld">
                <label for="aantal">Aantal deelnemers</label>
                <input type="number" id="aantal" name="aantal" min="1" max="500" />
              </div>
            </div>

            <div class="veld">
              <label for="beroepsgroep">Beroepsgroep</label>
              <select id="beroepsgroep" name="beroepsgroep">
                <option value="">Weet ik nog niet</option>
                {perSector.map((s) => (
                  <optgroup label={s}>
                    {groepen.filter((g) => g.sector === s).map((g) => (
                      <option value={g.naam}>{g.naam}</option>
                    ))}
                  </optgroup>
                ))}
              </select>
            </div>

            <fieldset class="veld">
              <legend>Welk niveau?</legend>
              <div class="keuzerij">
                {NIVEAUS.map((n) => (
                  <label class="keuze" data-niveau={n}>
                    <input type="radio" name="niveau" value={NIVEAU_INFO[n].naam} />
                    <span>{NIVEAU_INFO[n].naam}</span>
                  </label>
                ))}
                <label class="keuze" data-niveau="geen">
                  <input type="radio" name="niveau" value="Nog onbekend" checked />
                  <span>Weet ik nog niet</span>
                </label>
              </div>
            </fieldset>

            <div class="veld">
              <label for="bericht">Wat speelt er? <span class="verplicht">*</span></label>
              <textarea id="bericht" name="bericht" rows="5" required
                placeholder="Bijvoorbeeld: wat er is gebeurd, hoe vaak het voorkomt, en wat het team al heeft geprobeerd."></textarea>
            </div>

            <p class="privacyregel">
              Je gegevens worden alleen gebruikt om op deze aanvraag te reageren.
              Zie de <a href={pad('/privacy/')}>privacyverklaring</a>.
            </p>

            <button type="submit" class="knop">
              Aanvraag versturen
              <span class="pijl" aria-hidden="true">→</span>
            </button>
          </form>
        ) : (
          <div class="geen-formulier">
            <h2 class="h3">Neem contact op</h2>
            {/* Hier stond "u krijgt binnen één werkdag antwoord van iemand die
                de trainingen zelf geeft". Dat had ik verzonnen: er is geen
                reactietermijn afgesproken en het is niet vastgesteld wie de
                telefoon opneemt. Een belofte op de site waar de opdrachtgever
                niet om heeft gevraagd, hoort er niet te staan. */}
            <p class="inleiding">
              {/* Geen nummer of tijden hier: die staan al in de openingszin en in het
                  blok Direct contact hiernaast. Drie keer hetzelfde in één scherm
                  las als rommelig (Gemini-review). */}
              Bel of mail rechtstreeks en vertel wat er speelt: welk team, wat
              er gebeurt en hoe vaak. Dan denken we mee over niveau en aanpak.
            </p>
            <div class="directe-knoppen">
              <a href={`tel:${SITE.telefoonUri}`} class="knop">
                Bel ons direct
                <span class="pijl" aria-hidden="true">→</span>
              </a>
              <a href={mailLink} class="knop knop-tweede">Mail je aanvraag</a>
            </div>
            <p class="notitie">
              <strong>Voor de beheerder:</strong> het online formulier staat klaar
              maar is nog niet gekoppeld aan een verzenddienst. Zie
              <code>WERKWIJZE.md</code>, hoofdstuk “Het contactformulier aanzetten”.
            </p>
          </div>
        )}
      </div>

      <!-- ---------- Gegevens ---------- -->
      <aside class="gegevens">
        <div class="gegevensblok" data-niveau="basis">
          <Chevron aantal={2} breedte="1.8rem" />
          <h2 class="h4">Direct contact</h2>
          <ul class="gegevenslijst">
            <li>
              <span class="etiket">Telefoon</span>
              <a href={`tel:${SITE.telefoonUri}`}>{SITE.telefoon}</a>
            </li>
            <li>
              <span class="etiket">E-mail</span>
              <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
            </li>
            <li>
              <span class="etiket">Bereikbaar</span>
              <span>{SITE.openingstijden}</span>
            </li>
          </ul>
        </div>

        <div class="gegevensblok" data-niveau="gevorderd">
          <h2 class="h4">Bezoekadres</h2>
          <address>
            {SITE.adres.straat}<br />
            {SITE.adres.postcode} {SITE.adres.plaats}<br />
            {SITE.adres.provincie}
          </address>
          <p class="klein">Trainingen vinden altijd plaats op jullie eigen locatie.</p>
        </div>

        <div class="gegevensblok" data-niveau="expert">
          <h2 class="h4">Goed om te weten</h2>
          <ul class="feitlijst">
            <li>Elke training duurt {FEITEN.duur}</li>
            <li>{FEITEN.groepsgrootte.charAt(0).toUpperCase() + FEITEN.groepsgrootte.slice(1)}</li>
            <li>{FEITEN.certificaat.charAt(0).toUpperCase() + FEITEN.certificaat.slice(1)} na afloop</li>
            <li>Offerte op maat per aanvraag</li>
          </ul>
          <a href={pad('/aanpak/')} class="pijllink">
            Lees hoe we werken
            <span class="pijl" aria-hidden="true">→</span>
          </a>
          <a href={pad('/kosten/')} class="pijllink">
            Wat bepaalt de prijs?
            <span class="pijl" aria-hidden="true">→</span>
          </a>
        </div>
      </aside>
    </div>
  </section>

  <section class="sectie op-licht">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">Voor u het bericht stuurt</p>
        <h2>Wat er in een aanvraag hoort</h2>
        <p class="inleiding">
          Hoe concreter de aanvraag, hoe sneller er iets zinnigs over te zeggen is.
          Deze vier dingen zijn genoeg om mee te beginnen; de rest komt in de intake.
        </p>
      </div>
      <ol class="aanleveren">
        <li>
          <span class="kaart-cijfer" aria-hidden="true">01</span>
          <h3 class="h4">Welke beroepsgroep</h3>
          <p>
            Het aanbod is per beroepsgroep opgebouwd. Staat de uwe er
            <a href={pad('/sectoren/')}>tussen</a>, noem hem dan; zo niet, beschrijf dan het werk.
          </p>
        </li>
        <li>
          <span class="kaart-cijfer" aria-hidden="true">02</span>
          <h3 class="h4">Hoeveel mensen</h3>
          <p>
            De groep telt {FEITEN.groepsgrootte}, bij expert {FEITEN.groepsgrootteExpert}.
            Bij een groter team gaat het om meerdere groepen.
          </p>
        </li>
        <li>
          <span class="kaart-cijfer" aria-hidden="true">03</span>
          <h3 class="h4">Wat er speelt</h3>
          <p>
            Wat er is gebeurd, hoe vaak het voorkomt en wat het team al heeft geprobeerd.
            Hieruit komt de casuïstiek waarmee geoefend wordt.
          </p>
        </li>
        <li>
          <span class="kaart-cijfer" aria-hidden="true">04</span>
          <h3 class="h4">Welk niveau, als je dat al weet</h3>
          <p>
            Nog onbekend mag ook. De <a href={pad('/niveaus/')}>drie niveaus</a> staan
            uitgelegd, en het vaststellen hoort bij de intake.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="sectie op-wit">
    <div class="omhulsel">
      <Vragen vragen={contactVragen} kop="Vragen over aanvraag en offerte" groep="vragen-contact" />
      <p class="vragen-voet">
        Vragen over de inhoud van een training staan op de pagina van je
        <a href={pad('/sectoren/')}>beroepsgroep</a>. Hoe een traject verloopt, staat bij
        <a href={pad('/aanpak/')}>de werkwijze</a>; wie de trainingen geven, bij
        <a href={pad('/over-ons/')}>over ons</a>.
      </p>
    </div>
  </section>
</Basis>

<style>
  .kop-sectie {
    background: var(--mist-50);
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) clamp(3rem, 2rem + 4vw, 5rem);
  }
  .kop-binnen { display: grid; gap: 1.25rem; justify-items: start; }

  .contact-indeling {
    display: grid;
    gap: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    align-items: start;
  }
  @media (min-width: 950px) {
    .contact-indeling { grid-template-columns: minmax(0, 1.25fr) minmax(0, 20rem); }
  }

  .formulier, .geen-formulier {
    display: grid;
    gap: 1.1rem;
    padding: clamp(1.25rem, 1rem + 1.2vw, 2.25rem);
    background: var(--wit);
    border: 1px solid var(--rand-licht);
    border-top: 3px solid var(--oranje-500);
    border-radius: var(--hoek);
  }

  .botval { position: absolute; opacity: 0; width: 0; height: 0; pointer-events: none; }

  .veld { display: grid; gap: 0.4rem; border: 0; padding: 0; margin: 0; min-width: 0; }
  .veld-rij { display: grid; gap: 1.1rem; }
  @media (min-width: 560px) { .veld-rij { grid-template-columns: 1fr 1fr; } }

  label, legend {
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--tekst-donker);
    padding: 0;
  }
  .verplicht { color: var(--oranje-op-wit); }

  input[type='text'], input[type='email'], input[type='tel'], input[type='number'],
  select, textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.9rem;
    background: var(--mist-50);
    border: 1px solid var(--rand-licht);
    border-radius: var(--hoek);
    color: var(--tekst-donker);
    font-size: 1rem;
    transition: border-color 160ms, background 160ms;
  }
  textarea { min-height: 8rem; resize: vertical; line-height: 1.6; }
  input:hover, select:hover, textarea:hover { border-color: var(--tekst-donker-zacht); }
  input:focus, select:focus, textarea:focus {
    border-color: var(--oranje-500);
    background: var(--mist-50);
  }
  ::placeholder { color: var(--tekst-donker-zacht); opacity: 1; }

  .keuzerij { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.15rem; }
  .keuze {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--rand-licht);
    border-radius: 999px;
    cursor: pointer;
    font-weight: 500;
    transition: border-color 160ms, background 160ms;
  }
  .keuze:hover { border-color: var(--niveau-op-wit); }
  .keuze input { accent-color: var(--niveau-op-wit); width: 1.05rem; height: 1.05rem; }
  .keuze:has(input:checked) {
    border-color: var(--niveau-op-wit);
    background: color-mix(in oklab, var(--niveau-op-wit) 16%, transparent);
  }

  .privacyregel { font-size: 0.85rem; color: var(--tekst-donker-zacht); }
  .privacyregel a { color: var(--oranje-op-wit); }

  .formulier button { justify-self: start; }

  .directe-knoppen { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .notitie {
    font-size: 0.85rem;
    color: var(--tekst-donker-zacht);
    padding: 0.9rem 1rem;
    background: var(--mist-50);
    border-left: 3px solid var(--paars-op-wit);
    border-radius: var(--hoek);
  }
  .notitie code { font-size: 0.95em; color: var(--tekst-donker-zacht); }

  .gegevens { display: grid; gap: 1rem; }
  .gegevensblok {
    display: grid;
    gap: 0.7rem;
    padding: clamp(1.1rem, 1rem + 0.5vw, 1.5rem);
    background: var(--wit);
    border: 1px solid var(--rand-licht);
    border-left: 3px solid var(--niveau-op-wit);
    border-radius: var(--hoek);
  }
  .gegevensblok :global(.chevron) { color: var(--niveau-op-wit); }

  .gegevenslijst, .feitlijst { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.7rem; }
  .gegevenslijst li { display: grid; gap: 0.1rem; }
  .etiket {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tekst-donker-zacht);
  }
  .gegevenslijst a {
    font-family: 'Manrope', system-ui, sans-serif;
    font-weight: 600;
    color: var(--tekst-donker);
    text-decoration: none;
  }
  .gegevenslijst a:hover { color: var(--oranje-op-wit); text-decoration: underline; text-underline-offset: 3px; }

  .feitlijst li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.92rem;
    color: var(--tekst-donker-zacht);
  }
  .feitlijst li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--niveau-op-wit);
  }

  address { font-style: normal; line-height: 1.7; color: var(--tekst-donker-zacht); }
  .klein { font-size: 0.85rem; color: var(--tekst-donker-zacht); }

  /* De vier dingen die in een aanvraag horen. Kolommen in plaats van een
     grid: dan bepaalt de langste kaart niet de hoogte van alle vier. */
  .aanleveren {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: clamp(0.75rem, 0.5rem + 1vw, 1.25rem);
  }
  @media (min-width: 640px) { .aanleveren { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1040px) { .aanleveren { grid-template-columns: repeat(4, 1fr); } }

  .aanleveren li {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: clamp(1.1rem, 0.9rem + 0.8vw, 1.6rem);
    background: var(--wit);
    border: 1px solid var(--rand-licht);
    border-radius: var(--hoek);
    border-top: 3px solid var(--oranje-op-wit);
  }
  .aanleveren p { color: var(--tekst-donker-zacht); font-size: 0.93rem; line-height: 1.6; margin: 0; }
  .aanleveren h3 { margin: 0; }
</style>

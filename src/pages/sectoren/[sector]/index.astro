---
import { getCollection, render } from 'astro:content';
import Basis from '../../../layouts/Basis.astro';
import Kruimels from '../../../components/Kruimels.astro';
import Icoon from '../../../components/Icoon.astro';
import Cijferstrip from '../../../components/Cijferstrip.astro';
import Vragen from '../../../components/Vragen.astro';
import Cta from '../../../components/Cta.astro';
import { NIVEAUS, NIVEAU_INFO, FEITEN, SECTORKADERS, pad } from '../../../lib/site';
import { paginaTitel, description, faqSchema } from '../../../lib/seo';

export async function getStaticPaths() {
  const sectoren = await getCollection('sectoren');
  return sectoren.map((s) => ({ params: { sector: s.data.slug }, props: { sector: s } }));
}

const { sector } = Astro.props;
const d = sector.data;
const { Content } = await render(sector);

// Niet elke sector heeft een eigen kader bovenop de Arbowet; wie er geen
// heeft, krijgt geen blok. Zie SECTORKADERS in lib/site.ts.
const kader = SECTORKADERS[d.slug];

const [beroepsgroepen, trainingen] = await Promise.all([
  getCollection('beroepsgroepen'),
  getCollection('trainingen'),
]);

const groepen = beroepsgroepen
  .filter((b) => b.data.sector === d.slug)
  .sort((a, b) => a.data.naam.localeCompare(b.data.naam, 'nl'));

const sectorTrainingen = trainingen.filter((t) => t.data.sector === d.slug);

const kruimels = [
  { naam: 'Home', url: pad('/') },
  { naam: 'Sectoren', url: pad('/sectoren/') },
  { naam: d.naam, url: pad(`/sectoren/${d.slug}/`) },
];

// "X trainingen beschikbaar" is eruit: dat is de catalogus tellen.
// Zie BESLUITEN.md hoofdstuk 3.
const cijfers = [
  { waarde: groepen.length, label: groepen.length === 1 ? 'beroepsgroep in deze sector' : 'beroepsgroepen in deze sector' },
  { waarde: 3, label: 'niveaus per beroepsgroep' },
  { waarde: FEITEN.duur, label: 'per training' },
];

// Sectorvragen gaan bewust over de sector als geheel — kiezen tussen
// beroepsgroepen, gemengde groepen — zodat ze niet botsen met de vragen op
// de beroepsgroeppagina's eronder.
const schema = [faqSchema(d.veelgestelde_vragen)].filter(Boolean);
---

<Basis
  titel={paginaTitel(`Agressietraining ${d.naam.toLowerCase()}`)}
  description={description(d.samenvatting)}
  niveau="basis"
  kruimels={kruimels}
  schema={schema}
>
  <section class="sector-kop op-licht gloed raster-achtergrond">
    <div class="omhulsel sector-kop-binnen">
      <Kruimels kruimels={kruimels} />
      <p class="bovenkop">Sector</p>
      <h1 class="display sector-titel">{d.naam}</h1>
      <p class="openingsantwoord">{d.samenvatting}</p>
    </div>
  </section>

  <section class="sectie-krap op-wit">
    <div class="omhulsel">
      <Cijferstrip cijfers={cijfers} />
    </div>
  </section>

  <section class="sectie op-licht">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">Beroepsgroepen</p>
        <h2>Kies de beroepsgroep die je traint</h2>
        <p class="inleiding">
          Elke beroepsgroep heeft een eigen pagina met drie niveaus en een
          training die op dat vak is geschreven.
        </p>
      </div>

      <div class="rooster rooster-3">
        {groepen.map((b) => {
          const eigen = trainingen.filter((t) => t.data.beroepsgroep === b.data.slug);
          return (
            <article class="kaart groepkaart onthul" data-niveau="basis">
              {/* Hier bewust géén groot cijfer: elke beroepsgroep heeft
                  precies drie trainingen, dus dat getal zou op elke kaart
                  hetzelfde zijn. Een cijfer dat nooit verandert is ruis.
                  De niveaustippen onderaan dragen die informatie al. */}
              <h3>
                <a href={pad(`/sectoren/${d.slug}/${b.data.slug}/`)} class="dekkende-link">
                  {b.data.naam}
                </a>
              </h3>
              <p>{description(b.data.samenvatting, 130)}</p>
              <ul class="niveaurij">
                {NIVEAUS.filter((n) => eigen.some((t) => t.data.niveau === n)).map((n) => (
                  <li data-niveau={n}><span class="stip" aria-hidden="true"></span>{NIVEAU_INFO[n].naam}</li>
                ))}
              </ul>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="sectie op-wit">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">Over deze sector</p>
        <h2>Agressie in {d.naam.toLowerCase()}</h2>
      </div>
      <div class="leestekst"><Content /></div>
    </div>
  </section>

  {kader && (
    <section class="sectie sectie-aansluitend op-wit">
      <div class="omhulsel">
        <div class="kaderblok">
          <p class="bovenkop">Kader</p>
          <h2>{kader.kop}</h2>
          <p>{kader.tekst}</p>
          <p class="kaderbronnen">
            <span class="kaderbron-label">Bronnen:</span>
            {kader.bronnen.map((b, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> · </span>}
                <a href={b.url} rel="noopener">{b.naam}</a>
              </>
            ))}
          </p>
          <a href={pad('/wet-en-regels/')} class="pijllink">
            Wat de Arbowet vraagt
            <span class="pijl" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  )}

  <section class="sectie op-licht">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">De drie niveaus</p>
        <h2>Waar begint je team?</h2>
      </div>
      <div class="rooster rooster-3">
        {NIVEAUS.map((n) => (
          <a href={pad(`/niveaus/${n}/`)} class="kaart onthul" data-niveau={n}>
            {/* Icoon in een tegeltje, net als op alle andere kaarten van de
                site. Hier stond nog de losse chevron uit de eerste opzet. */}
            <span class="kaart-icoon">
              <Icoon naam={{ basis: 'signaleren', gevorderd: 'grens', expert: 'beleid' }[n] as any} />
            </span>
            <span class="badge">{NIVEAU_INFO[n].naam}</span>
            <h3>{NIVEAU_INFO[n].kort}</h3>
            <p>{NIVEAU_INFO[n].omschrijving}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {d.veelgestelde_vragen.length > 0 && (
    <section class="sectie op-wit">
      <div class="omhulsel">
        <Vragen
          vragen={d.veelgestelde_vragen}
          kop={`Vragen over agressietraining in ${d.naam.toLowerCase()}`}
          groep={`vragen-${d.slug}`}
        />
        <p class="vragen-voet">
          Per beroepsgroep staan er andere vragen. Bekijk de pagina van je beroepsgroep
          hierboven, lees <a href={pad('/aanpak/')}>de werkwijze</a> of
          <a href={pad('/over-ons/')}>maak kennis met de trainers</a>.
        </p>
      </div>
    </section>
  )}

  <Cta
    kop={`Agressietraining in de sector ${d.naam.toLowerCase()}?`}
    tekst="Bureau Weerbaar en Veilig traint incompany, met casuïstiek uit je eigen praktijk. Vertel wat er speelt, dan denken we mee over beroepsgroep en niveau."
  />
</Basis>

<style>
  .sector-kop {
    background: var(--mist-50);
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) clamp(3rem, 2rem + 4vw, 5.5rem);
  }
  .sector-kop-binnen { display: grid; gap: 1.25rem; justify-items: start; }
  .sector-titel {
    background: var(--verloop-merk);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* De hele kaart is klikbaar, maar er is één echte link — beter voor
     voorlezers dan een link om het hele blok heen. */
  .groepkaart { position: relative; }
  .dekkende-link { color: inherit; text-decoration: none; }
  .dekkende-link::after { content: ''; position: absolute; inset: 0; }
  .groepkaart:hover .dekkende-link { color: var(--oranje-op-wit); }

  .niveaurij {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    list-style: none;
    padding: 0;
    margin-top: auto;
    padding-top: 0.5rem;
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 0.82rem;
    color: var(--tekst-donker-zacht);
  }
  .niveaurij li { display: flex; align-items: center; gap: 0.4rem; }
  .stip {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--niveau-op-wit);
    flex: none;
  }

  .kaderblok {
    max-width: 68ch;
    display: grid;
    gap: 0.9rem;
    padding: clamp(1.2rem, 1rem + 0.8vw, 1.9rem);
    background: var(--mist-50);
    border: 1px solid var(--rand-licht);
    border-left: 3px solid var(--niveau-op-wit);
    border-radius: var(--hoek);
  }
  .kaderblok h2 { margin: 0; font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem); }
  .kaderblok > p { color: var(--tekst-donker-zacht); }
  .kaderbronnen { font-size: 0.85rem; }
  .kaderbron-label { font-weight: 600; color: var(--tekst-donker); }
</style>

---
import { getCollection, render } from 'astro:content';
import Basis from '../../../../layouts/Basis.astro';
import Kruimels from '../../../../components/Kruimels.astro';
import NiveauBeeld from '../../../../components/NiveauBeeld.astro';
import NiveauLadder from '../../../../components/NiveauLadder.astro';
import TrainingKaart from '../../../../components/TrainingKaart.astro';
import Vragen from '../../../../components/Vragen.astro';
import Cta from '../../../../components/Cta.astro';
import { FEITEN, pad } from '../../../../lib/site';
import { paginaTitel, description, kortenaam, faqSchema } from '../../../../lib/seo';

export async function getStaticPaths() {
  const beroepsgroepen = await getCollection('beroepsgroepen');
  return beroepsgroepen.map((b) => ({
    params: { sector: b.data.sector, beroepsgroep: b.data.slug },
    props: { beroepsgroep: b },
  }));
}

const { beroepsgroep } = Astro.props;
const d = beroepsgroep.data;
const { Content } = await render(beroepsgroep);

const [sectoren, trainingen, beroepsgroepen] = await Promise.all([
  getCollection('sectoren'),
  getCollection('trainingen'),
  getCollection('beroepsgroepen'),
]);

const sector = sectoren.find((s) => s.data.slug === d.sector);
const sectorNaam = sector?.data.naam ?? d.sector;

const eigen = trainingen.filter((t) => t.data.beroepsgroep === d.slug);
const perNiveau = Object.fromEntries(eigen.map((t) => [t.data.niveau, t.data.slug]));

const buren = beroepsgroepen
  .filter((b) => b.data.sector === d.sector && b.data.slug !== d.slug)
  .slice(0, 4);

const kruimels = [
  { naam: 'Home', url: pad('/') },
  { naam: 'Sectoren', url: pad('/sectoren/') },
  { naam: sectorNaam, url: pad(`/sectoren/${d.sector}/`) },
  { naam: d.naam, url: pad(`/sectoren/${d.sector}/${d.slug}/`) },
];

// De vragen staan per beroepsgroep in de content en verschillen dus per
// pagina. Een gekopieerde FAQ zou de 44 pagina's juist inwisselbaar maken.
const schema = [faqSchema(d.veelgestelde_vragen)].filter(Boolean);
---

<Basis
  titel={paginaTitel(`Agressietraining ${kortenaam(d.naam).toLowerCase()}`)}
  description={description(d.samenvatting)}
  niveau="basis"
  kruimels={kruimels}
  schema={schema}
>
  <section class="groep-kop op-licht gloed schuin-onder">
    <div class="omhulsel groep-kop-raster">
      <div class="groep-kop-binnen">
        <Kruimels kruimels={kruimels} />
        <p class="bovenkop">{sectorNaam}</p>
        <h1>Agressietraining voor {d.naam.toLowerCase()}</h1>
        <p class="openingsantwoord">{d.samenvatting}</p>

        {/* Hier stond "{eigen.length} trainingen". Aantallen noemen we niet;
            zie BESLUITEN.md hoofdstuk 3. */}
        <ul class="snelfeiten">
          <li><strong>Drie niveaus</strong> basis, gevorderd, expert</li>
          <li><strong>{FEITEN.duur}</strong> per training</li>
          <li><strong>{FEITEN.groepsgrootte}</strong></li>
        </ul>
      </div>

      {/* Zonder `huidig` lichten alle drie de treden op: deze pagina gaat
          over alle niveaus, niet over één. */}
      <div class="groep-kop-beeld"><NiveauBeeld /></div>
    </div>
  </section>

  <section class="sectie op-licht">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">Kies een niveau</p>
        <h2>Drie niveaus voor {d.naam.toLowerCase()}</h2>
        <p class="inleiding">
          De niveaus bouwen op elkaar voort. Weet je niet zeker welk niveau past?
          Bureau Weerbaar en Veilig denkt mee.
        </p>
      </div>
      <NiveauLadder trainingen={perNiveau} beroepsgroep={d.naam} />
    </div>
  </section>

  <section class="sectie op-wit">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">De praktijk</p>
        <h2>Waarom deze beroepsgroep een eigen training heeft</h2>
      </div>
      <div class="leestekst"><Content /></div>
    </div>
  </section>

  {buren.length > 0 && (
    <section class="sectie op-licht">
      <div class="omhulsel">
        <div class="kop-blok">
          <p class="bovenkop">Ook in {sectorNaam.toLowerCase()}</p>
          <h2>Andere beroepsgroepen</h2>
        </div>
        <div class="rooster rooster-4">
          {buren.map((b) => (
            <a href={pad(`/sectoren/${b.data.sector}/${b.data.slug}/`)} class="kaart" data-niveau="basis">
              <h3>{b.data.naam}</h3>
              <p>{description(b.data.samenvatting, 110)}</p>
              <span class="pijllink kaart-voet">
                Bekijk
                <span class="pijl" aria-hidden="true">→</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {d.veelgestelde_vragen.length > 0 && (
    <section class="sectie op-wit">
      <div class="omhulsel">
        <Vragen
          vragen={d.veelgestelde_vragen}
          kop={`Vragen over agressietraining voor ${kortenaam(d.naam).toLowerCase()}`}
          groep={`vragen-${d.slug}`}
        />
        <p class="vragen-voet">
          Staat je vraag er niet bij? <a href={pad('/contact/')}>Stel hem rechtstreeks</a>,
          of lees eerst <a href={pad('/aanpak/')}>hoe Bureau Weerbaar en Veilig werkt</a> en
          <a href={pad('/over-ons/')}>wie de trainingen geven</a>.
        </p>
      </div>
    </section>
  )}

  <Cta
    kop={`Agressietraining voor ${d.naam.toLowerCase()}?`}
    tekst="Vertel wat er speelt in jullie organisatie. Bureau Weerbaar en Veilig adviseert over het juiste niveau en stemt de casuïstiek af op jullie praktijk."
  />
</Basis>

<style>
  .groep-kop {
    background: var(--mist-50);
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) clamp(3rem, 2rem + 4vw, 5rem);
  }
  /* minmax(0, ...) is nodig, anders duwt de lange kop de illustratie weg
     tot een streepje: een fr-kolom respecteert de minimale inhoudsbreedte. */
  .groep-kop-raster {
    display: grid;
    gap: clamp(1.5rem, 1rem + 3vw, 3rem);
    align-items: center;
  }
  @media (min-width: 950px) {
    .groep-kop-raster { grid-template-columns: minmax(0, 1fr) minmax(0, 16rem); }
  }
  .groep-kop-beeld { max-width: 16rem; width: 100%; margin-inline: auto; }
  @media (max-width: 949px) { .groep-kop-beeld { max-width: 11rem; } }

  .groep-kop-binnen { display: grid; gap: 1.25rem; justify-items: start; }
  .groep-kop h1 { max-width: 18ch; }

  .snelfeiten {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2rem;
    list-style: none;
    padding: 1.25rem 0 0;
    margin: 0.25rem 0 0;
    border-top: 1px solid var(--rand-licht);
    width: 100%;
    color: var(--tekst-donker-zacht);
    font-size: 0.95rem;
  }
  .snelfeiten strong {
    font-family: 'Manrope', system-ui, sans-serif;
    color: var(--oranje-op-wit);
    font-weight: 700;
  }

  .kaart-voet { margin-top: auto; padding-top: 0.4rem; font-size: 0.9rem; }
</style>

---
import { getCollection } from 'astro:content';
import Basis from '../layouts/Basis.astro';
import Icoon from '../components/Icoon.astro';
import { pad } from '../lib/site';
import { paginaTitel } from '../lib/seo';

/**
 * Tijdelijke vergelijkingspagina: vijf manieren om de 44 beroepsgroepen te
 * tonen. Bedoeld om één te kiezen; daarna gaat deze pagina weg.
 * Staat op noindex en buiten de sitemap.
 */

const [sectoren, beroepsgroepen] = await Promise.all([
  getCollection('sectoren'),
  getCollection('beroepsgroepen'),
]);

const perSector = sectoren
  .map((s) => ({
    naam: s.data.naam,
    slug: s.data.slug,
    // Platgeslagen tot { naam, slug }, zodat de varianten hieronder niet
    // telkens b.data.… hoeven te schrijven — daar ging het al een keer mis
    // en dat leverde links naar /undefined/ op.
    leden: beroepsgroepen
      .filter((b) => b.data.sector === s.data.slug)
      .sort((a, b) => a.data.naam.localeCompare(b.data.naam, 'nl'))
      .map((b) => ({ naam: b.data.naam, slug: b.data.slug })),
  }))
  .filter((s) => s.leden.length > 0)
  .sort((a, b) => a.naam.localeCompare(b.naam, 'nl'));

const alfabetisch = beroepsgroepen
  .map((b) => ({
    naam: b.data.naam,
    slug: b.data.slug,
    sector: b.data.sector,
    sectorNaam: sectoren.find((s) => s.data.slug === b.data.sector)?.data.naam ?? '',
    letter: b.data.naam[0].toUpperCase(),
  }))
  .sort((a, b) => a.naam.localeCompare(b.naam, 'nl'));

const letters = [...new Set(alfabetisch.map((b) => b.letter))].sort();

const SECTORICOON: Record<string, string> = {
  asielopvang: 'team', beveiliging: 'beveiliging', bibliotheken: 'bibliotheek',
  dierenzorg: 'dier', energie: 'energie', farmacie: 'farmacie',
  'financiele-dienstverlening': 'geld', horeca: 'horeca', 'justitiele-keten': 'recht',
  onderwijs: 'onderwijs', 'openbaar-vervoer': 'vervoer', 'overheid-handhaving': 'overheid',
  retail: 'winkel', sportaccommodaties: 'sport', transport: 'transport',
  uitvaart: 'uitvaart', welzijn: 'gesprek', woningcorporaties: 'woning', zorg: 'zorg',
};

// Filterregels voor variant B (alfabet), zonder JavaScript.
const letterRegels = letters
  .map((l) => `.abc:has(#abc-${l}:checked) .abc-rij:not([data-letter="${l}"]){display:none}`)
  .join('\n');
---

<Basis
  titel={paginaTitel('Ontwerpkeuze: vijf overzichten')}
  description="Tijdelijke vergelijkingspagina met vijf manieren om de beroepsgroepen te tonen."
  niveau="basis"
  noindex={true}
>
  <section class="sectie-krap">
    <div class="omhulsel">
      <p class="bovenkop">Kies er één</p>
      <h1>Vijf manieren om 44 beroepsgroepen te tonen</h1>
      <p class="inleiding">
        Zelfde gegevens, vijf indelingen. Zeg welke letter je wilt, dan bouw
        ik die op de homepage en gaat deze pagina weg.
      </p>
    </div>
  </section>

  <!-- ============ A ============ -->
  <section class="sectie op-licht variant">
    <div class="omhulsel">
      <div class="variantkop">
        <span class="letter">A</span>
        <div>
          <h2>Index in kolommen</h2>
          <p>Alles zichtbaar, geordend per sector. Dit staat er nu. Compact en snel te scannen, maar het oogt als een register.</p>
        </div>
      </div>

      <div class="a-index">
        {perSector.map((s) => (
          <section class="a-blok">
            <h3><a href={pad(`/sectoren/${s.slug}/`)}>{s.naam}</a></h3>
            <ul>
              {s.leden.map((b) => (
                <li><a href={pad(`/sectoren/${s.slug}/${b.slug}/`)}>{b.naam}</a></li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ B ============ -->
  <section class="sectie variant">
    <div class="omhulsel">
      <div class="variantkop">
        <span class="letter">B</span>
        <div>
          <h2>Alfabetisch met letterfilter</h2>
          <p>Eén lijst op beroepsnaam, sector als bijschrift. Klik een letter om te filteren. Snelst als je je eigen beroep al weet.</p>
        </div>
      </div>

      <div class="abc">
        <fieldset class="abc-balk">
          <legend class="alleen-voorlezer">Filter op beginletter</legend>
          <input type="radio" name="abc" id="abc-alle" checked />
          <label for="abc-alle">Alle</label>
          {letters.map((l) => (
            <>
              <input type="radio" name="abc" id={`abc-${l}`} />
              <label for={`abc-${l}`}>{l}</label>
            </>
          ))}
        </fieldset>

        <ul class="abc-lijst">
          {alfabetisch.map((b) => (
            <li class="abc-rij" data-letter={b.letter}>
              <a href={pad(`/sectoren/${b.sector}/${b.slug}/`)}>
                <span class="abc-naam">{b.naam}</span>
                <span class="abc-sector">{b.sectorNaam}</span>
                <span class="pijl" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ C ============ -->
  <section class="sectie op-licht variant">
    <div class="omhulsel">
      <div class="variantkop">
        <span class="letter">C</span>
        <div>
          <h2>Uitklapbaar per sector</h2>
          <p>Negentien regels, compact. Klik een sector open en de beroepsgroepen verschijnen eronder. Kort in rust, alles bereikbaar.</p>
        </div>
      </div>

      <div class="c-lijst">
        {perSector.map((s) => (
          <details class="c-blok" name="sectorkeuze">
            <summary>
              <span class="c-icoon"><Icoon naam={(SECTORICOON[s.slug] ?? 'vinkje') as any} breedte={18} /></span>
              <span class="c-naam">{s.naam}</span>
              <span class="c-aantal">{s.leden.length}</span>
              <span class="c-teken" aria-hidden="true"></span>
            </summary>
            <ul>
              {s.leden.map((b) => (
                <li><a href={pad(`/sectoren/${s.slug}/${b.slug}/`)}>{b.naam}<span class="pijl" aria-hidden="true">→</span></a></li>
              ))}
            </ul>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ D ============ -->
  <section class="sectie variant">
    <div class="omhulsel">
      <div class="variantkop">
        <span class="letter">D</span>
        <div>
          <h2>Kaarten per sector</h2>
          <p>Elke sector een eigen kaart met de beroepsgroepen erin. Alles zichtbaar, maar als ontworpen blokken in plaats van een register.</p>
        </div>
      </div>

      <div class="d-rooster">
        {perSector.map((s) => (
          <article class="d-kaart">
            <div class="d-kop">
              <span class="d-icoon"><Icoon naam={(SECTORICOON[s.slug] ?? 'vinkje') as any} breedte={20} /></span>
              <h3><a href={pad(`/sectoren/${s.slug}/`)}>{s.naam}</a></h3>
            </div>
            <ul>
              {s.leden.map((b) => (
                <li><a href={pad(`/sectoren/${s.slug}/${b.slug}/`)}>{b.naam}</a></li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ E ============ -->
  <section class="sectie op-licht variant">
    <div class="omhulsel">
      <div class="variantkop">
        <span class="letter">E</span>
        <div>
          <h2>Tabel: sector naast beroepsgroepen</h2>
          <p>De dichtste vorm. Negentien regels, alles op één scherm, de beroepsgroepen als losse links achter elkaar.</p>
        </div>
      </div>

      <div class="tabelomhulsel">
        <table class="e-tabel">
          <tbody>
            {perSector.map((s) => (
              <tr>
                <th scope="row"><a href={pad(`/sectoren/${s.slug}/`)}>{s.naam}</a></th>
                <td>
                  {s.leden.map((b, i) => (
                    <>
                      {i > 0 && <span class="e-punt" aria-hidden="true">·</span>}
                      <a href={pad(`/sectoren/${s.slug}/${b.slug}/`)}>{b.naam}</a>
                    </>
                  ))}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Basis>

<style is:inline set:html={letterRegels}></style>

<style>
  .variantkop {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    max-width: 46rem;
  }
  .letter {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    border-radius: var(--hoek);
    background: var(--verloop-warm);
    color: #1f1000;
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 1.3rem;
    font-weight: 800;
  }
  .variantkop h2 { margin-bottom: 0.3rem; }
  .variantkop p { color: var(--tekst-zacht); font-size: 0.98rem; line-height: 1.55; }
  .op-licht .variantkop p { color: var(--tekst-donker-zacht); }

  /* ---------- A ---------- */
  .a-index { columns: 4; column-gap: 2rem; }
  @media (max-width: 1080px) { .a-index { columns: 3; } }
  @media (max-width: 780px) { .a-index { columns: 2; } }
  @media (max-width: 520px) { .a-index { columns: 1; } }
  .a-blok { break-inside: avoid; margin-bottom: 1.4rem; }
  .a-blok h3 {
    font-size: 0.75rem; font-weight: 800; letter-spacing: 0.11em; text-transform: uppercase;
    margin-bottom: 0.4rem; padding-bottom: 0.4rem; border-bottom: 2px solid var(--rand-licht);
  }
  .a-blok h3 a { color: var(--oranje-op-wit); text-decoration: none; }
  .a-blok ul { list-style: none; padding: 0; margin: 0; }
  .a-blok li a {
    display: block; padding: 0.42rem 0; color: var(--tekst-donker-zacht);
    text-decoration: none; font-size: 0.94rem; line-height: 1.35;
  }
  .a-blok li a:hover { color: var(--oranje-op-wit); }

  /* ---------- B ---------- */
  .abc-balk { border: 0; padding: 0; margin: 0 0 1.25rem; display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .abc-balk input { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .abc-balk label {
    display: grid; place-items: center; min-width: 2.5rem; min-height: 2.5rem;
    padding: 0 0.6rem; border: 1px solid var(--rand-fel); border-radius: var(--hoek-rond);
    font-family: 'Manrope', system-ui, sans-serif; font-weight: 700; font-size: 0.9rem;
    color: var(--tekst-zacht); cursor: pointer; transition: background 140ms, color 140ms;
  }
  .abc-balk label:hover { color: var(--tekst); border-color: var(--tekst-zacht); }
  .abc-balk input:focus-visible + label { outline: 3px solid var(--amber-400); outline-offset: 2px; }
  .abc-balk input:checked + label { background: var(--verloop-warm); color: #1f1000; border-color: transparent; }

  .abc-lijst {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1px; background: var(--rand); border: 1px solid var(--rand);
    border-radius: var(--hoek); overflow: hidden;
  }
  .abc-rij a {
    display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: center; gap: 0.75rem;
    min-height: 3.1rem; padding: 0.6rem 0.9rem; background: var(--inkt-850);
    color: var(--tekst-zacht); text-decoration: none; height: 100%;
    transition: background 140ms, color 140ms;
  }
  .abc-naam { font-weight: 600; color: var(--tekst); font-size: 0.95rem; }
  .abc-sector { font-size: 0.78rem; color: var(--tekst-gedempt); }
  .abc-rij .pijl { color: var(--oranje-500); opacity: 0; transition: opacity 160ms; }
  .abc-rij a:hover { background: var(--inkt-800); }
  .abc-rij a:hover .pijl { opacity: 1; }

  /* ---------- C ---------- */
  .c-lijst {
    display: grid; gap: 1px; background: var(--rand-licht);
    border: 1px solid var(--rand-licht); border-radius: var(--hoek); overflow: hidden;
    max-width: 52rem;
  }
  .c-blok { background: var(--wit); }
  .c-blok summary {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; align-items: center; gap: 0.85rem;
    min-height: 3.4rem; padding: 0.7rem 1rem; cursor: pointer; list-style: none;
  }
  .c-blok summary::-webkit-details-marker { display: none; }
  .c-blok summary:hover { background: var(--mist-50); }
  .c-icoon {
    display: grid; place-items: center; width: 34px; height: 34px; border-radius: var(--hoek-klein);
    background: color-mix(in oklab, var(--oranje-op-wit) 12%, var(--wit)); color: var(--oranje-op-wit);
  }
  .c-naam { font-family: 'Manrope', system-ui, sans-serif; font-weight: 700; font-size: 1rem; }
  .c-aantal { font-size: 0.82rem; font-weight: 700; color: var(--tekst-donker-zacht); }
  .c-teken { position: relative; width: 0.9rem; height: 0.9rem; }
  .c-teken::before, .c-teken::after {
    content: ''; position: absolute; inset: 50% 0 auto 0; height: 2px;
    background: var(--oranje-op-wit); transition: transform 200ms;
  }
  .c-teken::after { transform: rotate(90deg); }
  .c-blok[open] .c-teken::after { transform: rotate(0deg); }
  .c-blok ul {
    list-style: none; margin: 0; padding: 0 1rem 0.9rem 4.1rem;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); gap: 0.15rem;
  }
  .c-blok li a {
    display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
    padding: 0.42rem 0.5rem 0.42rem 0; color: var(--tekst-donker-zacht);
    text-decoration: none; font-size: 0.93rem;
  }
  .c-blok li a:hover { color: var(--oranje-op-wit); }
  .c-blok li .pijl { opacity: 0; }
  .c-blok li a:hover .pijl { opacity: 1; }

  /* ---------- D ---------- */
  .d-rooster {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: clamp(0.85rem, 0.7rem + 0.6vw, 1.25rem);
  }
  .d-kaart {
    background: var(--inkt-850); border: 1px solid var(--rand);
    border-radius: var(--hoek); padding: 1.1rem 1.2rem 1rem;
    transition: transform 180ms, box-shadow 180ms;
  }
  .d-kaart:hover { transform: translateY(-3px); box-shadow: var(--schaduw-donker); }
  .d-kop { display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.7rem; }
  .d-icoon {
    display: grid; place-items: center; width: 36px; height: 36px; flex: none;
    border-radius: var(--hoek-klein);
    background: color-mix(in oklab, var(--oranje-500) 16%, transparent); color: var(--oranje-400);
  }
  .d-kop h3 { font-size: 1rem; }
  .d-kop h3 a { color: var(--tekst); text-decoration: none; }
  .d-kaart ul { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--rand); }
  .d-kaart li a {
    display: block; padding: 0.4rem 0; color: var(--tekst-zacht);
    text-decoration: none; font-size: 0.9rem; line-height: 1.35;
  }
  .d-kaart li a:hover { color: var(--oranje-400); }

  /* ---------- E ---------- */
  .e-tabel { min-width: 44rem; }
  .e-tabel th[scope='row'] {
    width: 13rem; vertical-align: top; padding: 0.85rem 1.25rem 0.85rem 0;
    font-family: 'Manrope', system-ui, sans-serif; font-weight: 800; font-size: 0.9rem;
  }
  .e-tabel th a { color: var(--oranje-op-wit); text-decoration: none; }
  .e-tabel td { padding: 0.85rem 0; line-height: 1.7; }
  .e-tabel td a {
    color: var(--tekst-donker-zacht); text-decoration: none; font-size: 0.93rem;
  }
  .e-tabel td a:hover { color: var(--tekst-donker); text-decoration: underline; text-underline-offset: 3px; }
  .e-punt { color: var(--rand-licht); margin: 0 0.45rem; }
</style>

---
import { getCollection } from 'astro:content';
import Basis from '../../layouts/Basis.astro';
import Kruimels from '../../components/Kruimels.astro';
import Keuzehulp from '../../components/Keuzehulp.astro';
import NiveauLadder from '../../components/NiveauLadder.astro';
import Vragen from '../../components/Vragen.astro';
import Cta from '../../components/Cta.astro';
import { NIVEAUS, NIVEAU_INFO, FEITEN, MODEL, pad } from '../../lib/site';
import { paginaTitel, description, lijstSchema, faqSchema } from '../../lib/seo';

const trainingen = await getCollection('trainingen');

const kruimels = [
  { naam: 'Home', url: pad('/') },
  { naam: 'Niveaus', url: pad('/niveaus/') },
];

const openingsantwoord = `Bureau Weerbaar en Veilig biedt elke agressietraining aan in drie niveaus, samen ${MODEL.naam}. Basis leert agressie herkennen en de-escaleren, gevorderd gaat over begrenzen onder druk en nazorg, en expert richt zich op leidinggevenden die beleid en teamnorm moeten borgen. Elk niveau duurt ${FEITEN.duur} en je team stapt in waar het staat.`;

const vergelijking = [
  {
    vraag: 'Waar begint een team dat nog nooit een agressietraining heeft gehad?',
    antwoord:
      'Bij basis. Dat niveau gaat ervan uit dat deelnemers geen voorkennis hebben en legt het fundament: signalen herkennen, de eigen reactie reguleren en het gesprek terugbrengen. Ook ervaren medewerkers halen er iets uit, omdat de casuïstiek uit hun eigen beroepsgroep komt.',
  },
  {
    vraag: 'Moet iedereen eerst basis doen voordat gevorderd kan?',
    antwoord:
      'Niet per se. Gevorderd gaat ervan uit dat je de basis beheerst, door training of door ervaring. Werkt een team al jaren met zware situaties, dan kan gevorderd het juiste startpunt zijn. Bureau Weerbaar en Veilig kijkt daar per team naar.',
  },
  {
    vraag: 'Voor wie is expert bedoeld?',
    antwoord:
      'Voor leidinggevenden, coördinatoren en preventiemedewerkers. Het gaat niet over de eigen vaardigheid in een confrontatie, maar over wat de organisatie eromheen moet regelen: teamnorm, meldingsbereidheid, nazorg en borging.',
  },
  {
    vraag: 'Kan een team meerdere niveaus na elkaar doen?',
    antwoord:
      'Ja, en dat is ook de bedoeling. De drie niveaus zijn zo geschreven dat ze op elkaar voortbouwen zonder te herhalen. Veel organisaties trainen eerst de uitvoerende medewerkers op basis en daarna de leidinggevenden op expert.',
  },
];
const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site).href;
const lijst = lijstSchema(siteUrl, 'De drie niveaus agressietraining',
  NIVEAUS.map((x) => ({ naam: NIVEAU_INFO[x].naam, url: pad(`/niveaus/${x}/`) })));
---

<Basis
  titel={paginaTitel('De drie niveaus: basis, gevorderd en expert')}
  description={description(openingsantwoord)}
  niveau="basis"
  kruimels={kruimels}
  schema={[lijst, faqSchema(vergelijking)].filter(Boolean)}
>
  <section class="kop-sectie op-licht gloed raster-achtergrond">
    <div class="omhulsel kop-binnen">
      <Kruimels kruimels={kruimels} />
      <p class="bovenkop">{MODEL.naamHoofdletter}</p>
      <h1 class="display">Drie niveaus, <br /><span class="verloopwoord">één leerlijn</span></h1>
      <p class="openingsantwoord">{openingsantwoord}</p>
    </div>
  </section>

  <section class="sectie op-wit">
    <div class="omhulsel">
      <NiveauLadder />
    </div>
  </section>

  {/* Vergelijkingstabel (SEO/GEO-review 31-08-2026): een echte tabel is voor
    een AI-assistent letterlijk overneembaar. Eén plek op de site, zodat er
    geen 44 kopieën ontstaan. */}
  {/* Dezelfde keuzehulp als op de homepage. Herbouwd op 31-08-2026: de drie
      niveaus blijven staan en de antwoorden markeren er een, zodat je kunt
      blijven vergelijken (opmerking Youri). */}
  <section class="sectie op-licht">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">Keuzehulp</p>
        <h2>Welk niveau past bij jullie?</h2>
      </div>
      <Keuzehulp />
    </div>
  </section>

  <section class="sectie sectie-aansluitend op-wit">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">In één oogopslag</p>
        <h2>De drie niveaus vergeleken</h2>
      </div>
      <div class="tabelrol">
        <table class="niveautabel">
          <caption class="alleen-voorlezer">De drie niveaus van de Weerbaarheidsladder vergeleken op doelgroep, kern, duur, groepsgrootte en trainingsacteur.</caption>
          <thead>
            <tr>
              <th scope="col"><span class="alleen-voorlezer">Eigenschap</span></th>
              {NIVEAUS.map((n) => <th scope="col" data-niveau={n}>{NIVEAU_INFO[n].naam}</th>)}
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Voor wie</th>
              {NIVEAUS.map((n) => <td>{NIVEAU_INFO[n].voorWie}</td>)}
            </tr>
            <tr>
              <th scope="row">Kern</th>
              {NIVEAUS.map((n) => <td>{NIVEAU_INFO[n].kort}</td>)}
            </tr>
            <tr>
              <th scope="row">Duur</th>
              {NIVEAUS.map(() => <td>{FEITEN.duur}, incompany</td>)}
            </tr>
            <tr>
              <th scope="row">Groepsgrootte</th>
              {NIVEAUS.map((n) => <td>{n === 'expert' ? FEITEN.groepsgrootteExpert : FEITEN.groepsgrootte}</td>)}
            </tr>
            <tr>
              <th scope="row">Trainingsacteur</th>
              {NIVEAUS.map((n) => <td>{n === 'expert' ? 'Werksessie: analyse en borging staan centraal' : 'Speelt standaard mee in de oefengesprekken'}</td>)}
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="sectie op-licht">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">Naast elkaar</p>
        <h2>Wat is het verschil precies?</h2>
      </div>

      <div class="tabelomhulsel">
        <table class="vergelijk">
          <thead>
            <tr>
              <th scope="col">
                <span class="alleen-voorlezer">Onderwerp</span>
              </th>
              {NIVEAUS.map((n) => (
                <th scope="col" data-niveau={n}>
                  <span class="badge">{NIVEAU_INFO[n].naam}</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Kern</th>
              {NIVEAUS.map((n) => <td>{NIVEAU_INFO[n].kort}</td>)}
            </tr>
            <tr>
              <th scope="row">Voor wie</th>
              {NIVEAUS.map((n) => <td>{NIVEAU_INFO[n].voorWie}</td>)}
            </tr>
            <tr>
              <th scope="row">Duur</th>
              {NIVEAUS.map(() => <td>{FEITEN.duur}</td>)}
            </tr>
            <tr>
              <th scope="row">Groepsgrootte</th>
              <td>{FEITEN.groepsgrootte}</td>
              <td>{FEITEN.groepsgrootte}</td>
              <td>{FEITEN.groepsgrootteExpert}</td>
            </tr>
            <tr>
              <th scope="row">Aantal trainingen</th>
              {NIVEAUS.map((n) => (
                <td>{trainingen.filter((t) => t.data.niveau === n).length}</td>
              ))}
            </tr>
            <tr>
              <th scope="row"><span class="alleen-voorlezer">Naar het niveau</span></th>
              {NIVEAUS.map((n) => (
                <td>
                  <a href={pad(`/niveaus/${n}/`)} class="pijllink">
                    Bekijk
                    <span class="pijl" aria-hidden="true">→</span>
                  </a>
                </td>
              ))}
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="sectie op-wit">
    <div class="omhulsel">
      <Vragen vragen={vergelijking} kop="Vragen over de niveaus" groep="niveauvragen" />
    </div>
  </section>

  <Cta
    kop="Niet zeker welk niveau past?"
    tekst="Vertel wat er speelt en wat het team al kan. Bureau Weerbaar en Veilig adviseert welk niveau aansluit, ook als dat een lager niveau is dan je in gedachten had."
  />
</Basis>

<style>
  .kop-sectie {
    background: var(--mist-50);
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) clamp(3rem, 2rem + 4vw, 5.5rem);
  }
  .kop-binnen { display: grid; gap: 1.25rem; justify-items: start; }

  .vergelijk { min-width: 46rem; }
  .vergelijk th[scope='col'] { padding-bottom: 1rem; }
  .vergelijk th[scope='row'] {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tekst-donker-zacht);
    white-space: nowrap;
    padding-right: 1.5rem;
    vertical-align: top;
  }
  .vergelijk td { vertical-align: top; color: var(--tekst-donker); }
  .vergelijk tbody tr:hover { background: var(--mist-100); }

  .tabelrol {
    overflow-x: auto;
    border: 1px solid var(--rand-licht);
    border-radius: var(--hoek);
    background: var(--wit);
  }
  .niveautabel { border-collapse: collapse; width: 100%; min-width: 44rem; }
  .niveautabel th, .niveautabel td {
    text-align: left;
    vertical-align: top;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--rand-licht);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .niveautabel tbody tr:last-child th, .niveautabel tbody tr:last-child td { border-bottom: 0; }
  .niveautabel thead th {
    font-family: 'Manrope', system-ui, sans-serif;
    font-weight: 700;
    border-bottom: 2px solid var(--niveau-op-wit);
    background: color-mix(in oklab, var(--niveau-op-wit) 7%, var(--wit));
  }
  .niveautabel thead th:first-child { background: var(--wit); border-bottom-color: var(--rand-licht); }
  .niveautabel tbody th {
    width: 9.5rem;
    font-family: 'Manrope', system-ui, sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
    background: var(--mist-50);
    color: var(--tekst-donker);
  }
  .niveautabel td { color: var(--tekst-donker-zacht); }
</style>

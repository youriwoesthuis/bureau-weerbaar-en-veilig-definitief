---
import { getCollection } from 'astro:content';
import Basis from '../layouts/Basis.astro';
import Kruimels from '../components/Kruimels.astro';
import Icoon from '../components/Icoon.astro';
import Pdca from '../components/Pdca.astro';
import Groeimodel from '../components/Groeimodel.astro';
import Rolverdeling from '../components/Rolverdeling.astro';
import Vragen from '../components/Vragen.astro';
import Cta from '../components/Cta.astro';
import { FEITEN, pad } from '../lib/site';
import { paginaTitel, description } from '../lib/seo';

const [beroepsgroepen, trainingen, team] = await Promise.all([
  getCollection('beroepsgroepen'),
  getCollection('trainingen'),
  getCollection('team'),
]);

// Hier werd geteld hoeveel teamleden trainingsacteur zijn. Dat hoeft niet
// zo expliciet: het zijn gewoon teamleden. Zie BESLUITEN.md hoofdstuk 3.

const kruimels = [
  { naam: 'Home', url: pad('/') },
  { naam: 'Aanpak', url: pad('/aanpak/') },
];

const openingsantwoord = `Een agressietraining van Bureau Weerbaar en Veilig duurt ${FEITEN.duur}, telt ${FEITEN.groepsgrootte} en wordt altijd bij jullie op locatie gegeven, met casuïstiek uit de eigen praktijk van de deelnemers. Er wordt geoefend met een trainer én een trainingsacteur; die speelt standaard mee. Deelnemers ontvangen na afloop een ${FEITEN.certificaat}.`;

const uitgangspunten = [
  {
    icoon: 'oefenen' as const,
    kop: 'Oefenen boven uitleggen',
    tekst:
      'Weten wat je moet doen en het kunnen doen terwijl iemand tegen je schreeuwt, zijn twee verschillende dingen. Daarom ligt het zwaartepunt op oefenen.',
  },
  {
    icoon: 'signaleren' as const,
    kop: 'Geen angstverhalen',
    tekst:
      'De training gaat over vakmanschap, niet over dreiging. Deelnemers moeten na afloop meer grip voelen, niet meer angst.',
  },
  {
    icoon: 'grens' as const,
    kop: 'Grenzen stellen mag',
    tekst:
      'Veel medewerkers denken dat begrenzen onprofessioneel is. De training laat zien dat het omgekeerde waar is: duidelijk zijn is onderdeel van goede dienstverlening en goede zorg.',
  },
  {
    icoon: 'beleid' as const,
    kop: 'De organisatie hoort erbij',
    tekst:
      'Een team dat leert de-escaleren in een organisatie die meldingen niet oppakt, houdt het niet vol. Daarom bestaat niveau expert: voor de mensen die daarover gaan.',
  },
];

const vragen = [
  {
    vraag: 'Hoe lang duurt een agressietraining?',
    antwoord: `Elke training duurt ${FEITEN.duur}. Dat geldt voor alle drie de niveaus en voor elke beroepsgroep.`,
  },
  {
    vraag: 'Hoeveel deelnemers kunnen er mee?',
    antwoord: `${FEITEN.groepsgrootte.charAt(0).toUpperCase() + FEITEN.groepsgrootte.slice(1)}. Bij niveau expert is de groep kleiner: ${FEITEN.groepsgrootteExpert}, omdat daar meer ruimte nodig is voor het eigen beleid van de organisatie.`,
  },
  {
    vraag: 'Werken jullie met trainingsacteurs?',
    antwoord:
      'Ja, standaard. Een trainingsacteur speelt bij elke training mee. Die zet een situatie precies zo neer als een deelnemer hem kent, en kan het gedrag bijstellen zodat er stap voor stap geoefend kan worden.',
  },
  {
    vraag: 'Kan de training bij ons op locatie?',
    antwoord:
      'Ja, en anders niet. De trainingen worden altijd incompany gegeven, bij jullie op locatie, in heel Nederland. Dat is geen praktische keuze maar een inhoudelijke: er wordt geoefend in de ruimte waar het werk gebeurt.',
  },
  {
    vraag: 'Krijgen deelnemers een certificaat?',
    antwoord: `Deelnemers ontvangen na afloop een ${FEITEN.certificaat}. Dat is geen wettelijk erkend diploma, maar een bewijs van deelname dat organisaties kunnen opnemen in het eigen opleidingsdossier.`,
  },
  {
    vraag: 'Wat kost een training?',
    antwoord:
      'Er staat geen prijs op de site, omdat elke aanvraag anders is. Wat de prijs bepaalt: het aantal groepen, het niveau, de reisafstand en de omvang van het traject. De trainingsacteur niet — die zit er standaard bij.',
  },
];
---

<Basis
  titel={paginaTitel('Onze aanpak van agressietraining')}
  description={description(openingsantwoord)}
  niveau="gevorderd"
  kruimels={kruimels}
>
  <section class="kop-sectie op-licht gloed raster-achtergrond">
    <div class="omhulsel kop-binnen">
      <Kruimels kruimels={kruimels} />
      <p class="bovenkop">Aanpak</p>
      <h1 class="display">Oefenen tot<br /><span class="verloopwoord">het gedrag zit</span></h1>
      <p class="openingsantwoord">{openingsantwoord}</p>
    </div>
  </section>

  {/* Hier stond een lijst "Vier stappen" die inhoudelijk hetzelfde zei als
      de PDCA-cyclus op de homepage — "De trainingsdag" stond er zelfs
      letterlijk twee keer. Twee pagina's die om dezelfde zoekopdracht
      concurreren en voor de lezer als herhaling lezen. De cyclus hoort op
      deze pagina thuis, dus die staat hier nu voluit; de homepage verwijst
      er alleen nog naar. */}
  <section class="sectie op-wit">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">Van eerste gesprek tot werkvloer</p>
        <h2>Een training is geen dag, maar een stap</h2>
        <p class="inleiding">
          Bureau Weerbaar en Veilig werkt in de cyclus die je zelf ook gebruikt
          bij verbeteren: plan, do, check, act. Klik een fase aan om te zien
          wat er in die stap gebeurt.
        </p>
      </div>
      <Pdca />
    </div>
  </section>

  <!-- ---------------- Groeimodel: wat er per niveau groeit ---------------- -->
  <section class="sectie op-licht">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">Het groeimodel</p>
        <h2>Wat er groeit als een team een niveau opschuift</h2>
        <p class="inleiding">
          De drie niveaus verschillen niet in zwaarte alleen, maar in bereik.
          Basis en gevorderd gaan over het eigen handelen; expert gaat over de
          organisatie eromheen. Kies een niveau om te zien wat er dan bij komt.
        </p>
      </div>
      <Groeimodel />
    </div>
  </section>

  <!-- ---------------- Rolverdeling ---------------- -->
  <section class="sectie op-wit">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">Wie doet wat</p>
        <h2>Een training werkt alleen als drie partijen iets doen</h2>
        <p class="inleiding">
          Bureau Weerbaar en Veilig geeft de trainingsdag, maar dat is één van
          de drie rollen. Zonder wat de organisatie inbrengt is er geen
          casuïstiek, en zonder wat het team erna doet blijft er niets van over.
        </p>
      </div>
      <Rolverdeling />
    </div>
  </section>

  <!-- ---------------- De trainingsacteur ---------------- -->
  <section class="sectie op-licht">
    <div class="omhulsel acteur">
      <div class="acteur-tekst">
        <p class="bovenkop">De trainingsacteur</p>
        <h2>Waarom er iemand meespeelt</h2>
        <p class="inleiding">
          Weten wat je moet doen en het kúnnen doen terwijl iemand tegen je
          schreeuwt, zijn twee verschillende dingen. Die tweede leer je alleen
          door het te doen — en daarvoor is iemand nodig die het gedrag
          neerzet zoals jij hem kent.
        </p>

        <ul class="acteurlijst">
          <li>
            <span class="acteur-icoon"><Icoon naam="gesprek" breedte={20} /></span>
            <span>
              <strong>Jullie situatie, niet een voorbeeld.</strong>
              De acteur speelt de casus die uit de meldingen van je eigen team
              komt, in de taal en de omgeving van dat team.
            </span>
          </li>
          <li>
            <span class="acteur-icoon"><Icoon naam="grens" breedte={20} /></span>
            <span>
              <strong>Het gedrag gaat stap voor stap omhoog.</strong>
              Een acteur kan de druk opvoeren of juist terugnemen, zodat een
              deelnemer op zijn eigen tempo kan oefenen in plaats van meteen
              in het diepe te vallen.
            </span>
          </li>
          <li>
            <span class="acteur-icoon"><Icoon naam="oefenen" breedte={20} /></span>
            <span>
              <strong>Dezelfde minuut nog eens, met andere keuzes.</strong>
              Dat is wat een acteur mogelijk maakt en een videofragment of een
              rollenspel tussen collega's niet: herhalen tot het zit.
            </span>
          </li>
        </ul>
      </div>

      <aside class="acteur-cijfer">
        <p class="kaart-cijfer">
          <b>Altijd</b>
          <small>een acteur erbij</small>
        </p>
        <p>
          De trainingsacteur is geen optie tegen meerprijs en geen ingehuurde
          losse kracht, maar onderdeel van het team. Bij elke training speelt
          er iemand mee.
        </p>
        <a href={pad('/over-ons/')} class="pijllink">
          Bekijk wie er meespelen
          <span class="pijl" aria-hidden="true">→</span>
        </a>
      </aside>
    </div>
  </section>

  <section class="sectie op-wit">
    <div class="omhulsel">
      <div class="kop-blok">
        <p class="bovenkop">Uitgangspunten</p>
        <h2>Waar we van uitgaan</h2>
      </div>
      <div class="rooster rooster-4">
        {uitgangspunten.map((u, i) => (
          <article class="kaart onthul" data-niveau={['basis', 'gevorderd', 'expert', 'basis'][i]}>
            <span class="kaart-icoon"><Icoon naam={u.icoon} /></span>
            <h3>{u.kop}</h3>
            <p>{u.tekst}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sectie op-licht">
    <div class="omhulsel">
      <Vragen vragen={vragen} kop="Praktische vragen" groep="aanpakvragen" />
      <p class="meer">
        <a href={pad('/trainingen/')} class="pijllink">
          Bekijk alle trainingen
          <span class="pijl" aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>

  <Cta />
</Basis>

<style>
  .kop-sectie {
    background: var(--mist-50);
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) clamp(3rem, 2rem + 4vw, 5.5rem);
  }
  .kop-binnen { display: grid; gap: 1.25rem; justify-items: start; }
  .verloopwoord {
    background: var(--verloop-merk);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .meer { margin-top: clamp(1.5rem, 1.2rem + 1vw, 2.5rem); }

  /* ---- De trainingsacteur ---- */
  .acteur {
    display: grid;
    gap: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    align-items: start;
  }
  @media (min-width: 950px) {
    .acteur { grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr); }
  }

  .acteurlijst {
    list-style: none;
    padding: 0;
    margin: clamp(1.25rem, 1rem + 1vw, 2rem) 0 0;
    display: grid;
    gap: 1.1rem;
  }
  .acteurlijst li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.85rem;
    align-items: start;
    color: var(--tekst-donker-zacht);
    line-height: 1.6;
  }
  .acteurlijst strong { color: var(--tekst-donker); display: block; }
  .acteur-icoon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex: none;
    border-radius: var(--hoek-klein);
    background: color-mix(in oklab, var(--niveau-op-wit) 12%, var(--wit));
    color: var(--niveau-op-wit);
  }

  .acteur-cijfer {
    display: grid;
    gap: 0.7rem;
    justify-items: start;
    padding: clamp(1.25rem, 1rem + 1vw, 1.9rem);
    background: var(--wit);
    border: 1px solid var(--rand-licht);
    border-top: 4px solid var(--niveau-op-wit);
    border-radius: var(--hoek);
    box-shadow: var(--schaduw-md);
  }
  .acteur-cijfer p { color: var(--tekst-donker-zacht); font-size: 0.95rem; line-height: 1.6; }
</style>

---
import { getCollection } from 'astro:content';
import Icoon from './Icoon.astro';
import { pad } from '../lib/site';

/**
 * Alle 44 beroepsgroepen, als een kaart per sector.
 *
 * Twee dingen die eerder misgingen en hier bewust anders zijn opgelost:
 *
 * 1. Dit verving een sectorkiezer met een paneel eronder. Dat was een
 *    tweestapswidget voor een eenstapstaak: iemand kent zijn eigen beroep en
 *    wil niet eerst raden onder welke sector wij het hebben gearchiveerd.
 *
 * 2. De kaarten staan in CSS-kolommen, niet in een raster. In een raster
 *    wordt elke rij zo hoog als de grootste kaart erin — met Zorg (acht
 *    beroepsgroepen) naast Energie (één) levert dat rijen vol lege ruimte
 *    op. Kolommen laten de kaarten strak op elkaar pakken; break-inside
 *    houdt een kaart heel.
 */

const [sectoren, beroepsgroepen] = await Promise.all([
  getCollection('sectoren'),
  getCollection('beroepsgroepen'),
]);

/** Eén icoon per sector, zodat elke kaart een eigen gezicht heeft. */
const SECTORICOON: Record<string, string> = {
  asielopvang: 'team',
  beveiliging: 'beveiliging',
  bibliotheken: 'bibliotheek',
  dierenzorg: 'dier',
  energie: 'energie',
  farmacie: 'farmacie',
  'financiele-dienstverlening': 'geld',
  horeca: 'horeca',
  'justitiele-keten': 'recht',
  onderwijs: 'onderwijs',
  'openbaar-vervoer': 'vervoer',
  'overheid-handhaving': 'overheid',
  retail: 'winkel',
  sportaccommodaties: 'sport',
  transport: 'transport',
  uitvaart: 'uitvaart',
  welzijn: 'gesprek',
  woningcorporaties: 'woning',
  zorg: 'zorg',
};

const groepen = sectoren
  .map((s) => ({
    naam: s.data.naam,
    slug: s.data.slug,
    icoon: SECTORICOON[s.data.slug] ?? 'vinkje',
    // Platgeslagen tot { naam, slug }: schrijven van b.data.… in de
    // opmaak hieronder ging al eens mis en leverde links naar
    // /undefined/ op die niemand zag.
    leden: beroepsgroepen
      .filter((b) => b.data.sector === s.data.slug)
      .sort((a, b) => a.data.naam.localeCompare(b.data.naam, 'nl'))
      .map((b) => ({ naam: b.data.naam, slug: b.data.slug })),
  }))
  .filter((s) => s.leden.length > 0)
  .sort((a, b) => a.naam.localeCompare(b.naam, 'nl'));
---

<div class="sectorkaarten">
  {groepen.map((s) => (
    <article class="sectorkaart">
      <div class="kaartkop">
        <span class="kaart-icoon-klein">
          <Icoon naam={s.icoon as any} breedte={19} />
        </span>
        <h3>
          <a href={pad(`/sectoren/${s.slug}/`)}>{s.naam}</a>
        </h3>
        <span class="kaart-aantal">{s.leden.length}</span>
      </div>

      <ul>
        {s.leden.map((b) => (
          <li>
            <a href={pad(`/sectoren/${s.slug}/${b.slug}/`)}>
              <span>{b.naam}</span>
              <span class="pijl" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </article>
  ))}
</div>

<style>
  .sectorkaarten {
    columns: 4;
    column-gap: clamp(0.85rem, 0.7rem + 0.6vw, 1.25rem);
  }
  @media (max-width: 1080px) { .sectorkaarten { columns: 3; } }
  @media (max-width: 760px) { .sectorkaarten { columns: 2; } }
  @media (max-width: 520px) { .sectorkaarten { columns: 1; } }

  .sectorkaart {
    break-inside: avoid;
    page-break-inside: avoid;
    margin-bottom: clamp(0.85rem, 0.7rem + 0.6vw, 1.25rem);
    background: var(--wit);
    border: 1px solid var(--rand-licht);
    border-radius: var(--hoek);
    padding: 1rem 1.1rem 0.85rem;
    transition: border-color 180ms, box-shadow 180ms, transform 180ms;
  }
  .sectorkaart:hover {
    border-color: transparent;
    box-shadow: var(--schaduw-md);
    transform: translateY(-2px);
  }

  .kaartkop {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.7rem;
    margin-bottom: 0.35rem;
    border-bottom: 1px solid var(--rand-licht);
  }
  .kaart-icoon-klein {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: var(--hoek-klein);
    background: color-mix(in oklab, var(--oranje-op-wit) 12%, var(--wit));
    color: var(--oranje-op-wit);
  }
  .kaartkop h3 { font-size: 0.98rem; line-height: 1.2; min-width: 0; flex: 1; }
  .kaartkop h3 a { color: var(--tekst-donker); text-decoration: none; }
  .kaartkop h3 a:hover { color: var(--oranje-op-wit); }
  .kaart-aantal {
    flex: none;
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--oranje-op-wit);
  }

  .sectorkaart ul { list-style: none; padding: 0; margin: 0; }
  .sectorkaart li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.38rem 0.4rem 0.38rem 0;
    color: var(--tekst-donker-zacht);
    text-decoration: none;
    font-size: 0.9rem;
    line-height: 1.35;
    border-radius: var(--hoek-klein);
    transition: color 140ms, background 140ms, padding-left 160ms;
  }
  .sectorkaart li a .pijl {
    flex: none;
    color: var(--oranje-op-wit);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 160ms, transform 160ms;
  }
  .sectorkaart li a:hover {
    color: var(--tekst-donker);
    background: var(--mist-100);
    padding-left: 0.4rem;
  }
  .sectorkaart li a:hover .pijl { opacity: 1; transform: none; }
</style>

---
import { NIVEAU_INFO, pad, type Niveau } from '../lib/site';

interface Props {
  slug: string;
  titel: string;
  niveau: Niveau;
  samenvatting?: string;
  beroepsgroep?: string;
  compact?: boolean;
}
const { slug, titel, niveau, samenvatting, beroepsgroep, compact = false } = Astro.props;
const info = NIVEAU_INFO[niveau];
---

<a href={pad(`/trainingen/${slug}/`)} class="kaart training-kaart" data-niveau={niveau}>
  <span class="badge">{info.naam}</span>
  <h3>{beroepsgroep ?? titel}</h3>
  <p class="kort">{info.kort}</p>
  {!compact && samenvatting && <p>{samenvatting}</p>}
  <span class="pijllink kaart-voet">
    Bekijk de training
    <span class="pijl" aria-hidden="true">→</span>
  </span>
</a>

<style>
  .training-kaart { height: 100%; }
  .kort {
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--niveau);
  }
  :global(.op-licht) .kort,
  :global(.op-wit) .kort { color: var(--niveau-op-wit); }
  .kaart-voet { margin-top: auto; padding-top: 0.4rem; font-size: 0.9rem; }
</style>

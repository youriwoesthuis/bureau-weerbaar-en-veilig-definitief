---
import Icoon from '../components/Icoon.astro';
import { NIVEAU_INFO, pad } from '../lib/site';

/**
 * De spanningscurve: hoe spanning oploopt en waar je er nog iets aan kunt
 * doen. Het bekendste model van dit vakgebied, en het maakt in één plaat
 * zichtbaar waarom er drie niveaus zijn — hoe later je ingrijpt, hoe minder
 * je overhoudt.
 *
 * Tweede versie, na feedback "dit is ook heel simpel": de tekening draagt
 * nu meer — gekleurde fasezones die met de keuze oplichten, faselabels in
 * de plaat zelf, en een tweede, gestippelde lijn die laat zien waar het om
 * gaat: wie vroeg ingrijpt, buigt de curve af voordat hij piekt. Die tweede
 * lijn is geen belofte maar het mechanisme zelf — de-escaleren ís de curve
 * afbuigen.
 *
 * LET OP voor de opdrachtgever: dit is vakinhoud, geen claim over Bureau
 * Weerbaar en Veilig. Loop de bewoordingen na en zeg het als jullie het in
 * de training anders benoemen — dan pas ik ze aan.
 *
 * Interactief zonder JavaScript: vijf radioknoppen plus :has().
 */

type Fase = {
  id: string;
  naam: string;
  icoon: Parameters<typeof Icoon>[0]['naam'];
  /** positie op de curve, 0 = links, 1 = rechts */
  t: number;
  zieJe: string;
  werkt: string;
  werktNiet: string;
  niveau: 'basis' | 'gevorderd' | 'expert';
};

const FASEN: Fase[] = [
  {
    id: 'rustig',
    naam: 'Rustig',
    icoon: 'gesprek',
    t: 0.04,
    zieJe: 'Een gewoon gesprek. Er is nog niets aan de hand, en juist daarom is dit de fase waarin je het meeste kunt.',
    werkt: 'Vragen stellen, uitleggen, verwachtingen bijstellen. Alles wat je hier afspreekt, hoef je later niet af te dwingen.',
    werktNiet: 'Er is nog niets om op te reageren. Wie hier al streng wordt, veroorzaakt de spanning die hij wil voorkomen.',
    niveau: 'basis',
  },
  {
    id: 'irritatie',
    naam: 'Irritatie',
    icoon: 'signaleren',
    t: 0.27,
    zieJe: 'De toon verandert voordat de woorden dat doen. Sneller praten, korter antwoorden, wegkijken, een been dat begint te wippen.',
    werkt: 'Benoemen wat je ziet en de ander laten uitpraten. Dit is het moment waarop de-escaleren nog bijna vanzelf gaat.',
    werktNiet: 'Doorgaan met je verhaal alsof je niets merkt. Het signaal wordt dan harder herhaald.',
    niveau: 'basis',
  },
  {
    id: 'spanning',
    naam: 'Spanning',
    icoon: 'grens',
    t: 0.53,
    zieJe: 'Stemverheffing, verwijten, dichterbij komen. De inhoud van het gesprek doet er nauwelijks meer toe.',
    werkt: 'Grenzen stellen in korte zinnen, en zeggen wat er gebeurt als het doorgaat. Rustig blijven is hier vakwerk, geen karaktereigenschap.',
    werktNiet: 'Uitleggen waarom de regel bestaat. Argumenten werken niet meer zodra iemand in de spanning zit.',
    niveau: 'gevorderd',
  },
  {
    id: 'escalatie',
    naam: 'Escalatie',
    icoon: 'beveiliging',
    t: 0.76,
    zieJe: 'Schelden, dreigen, duwen. De ander heeft de rem losgelaten en is niet meer aanspreekbaar op redelijkheid.',
    werkt: 'Veiligheid eerst: afstand, uitgang, hulp halen, het gesprek beëindigen. Niet winnen maar wegkomen.',
    werktNiet: 'Nog één keer proberen te overtuigen. Wie hier blijft praten, blijft ook staan waar hij weg had moeten zijn.',
    niveau: 'gevorderd',
  },
  {
    id: 'nasleep',
    naam: 'Nasleep',
    icoon: 'nazorg',
    t: 0.96,
    zieJe: 'Het is voorbij. Wat er nu gebeurt bepaalt of het incident iets verandert of alleen iets kost.',
    werkt: 'Melden, nabespreken, en vastleggen wat het team voortaan wel en niet accepteert. Dit ligt bij de organisatie, niet bij de medewerker.',
    werktNiet: 'Alleen opvangen en verder gaan. Dan is er over een maand een tweede incident en is er niets geleerd.',
    niveau: 'expert',
  },
];

/* ---------- meetkunde ---------- */
const B = { x0: 30, x1: 700, y0: 252, y1: 46 };
const X = (t: number) => B.x0 + (B.x1 - B.x0) * t;

/** De curve zonder ingrijpen: oplopen tot de piek, dan de nasleep. */
const hoog = (t: number) => (t <= 0.78 ? Math.pow(t / 0.78, 1.75) : 1 - (t - 0.78) * 1.1);
const punt = (t: number) => ({ x: X(t), y: B.y0 - (B.y0 - B.y1) * hoog(t) });

/** Dezelfde situatie, maar vroeg afgebogen: komt half zo hoog en landt eerder. */
const laag = (t: number) => {
  const h = t <= 0.5 ? Math.pow(t / 0.5, 1.6) * 0.46 : Math.max(0.46 - (t - 0.5) * 0.68, 0.12);
  return { x: X(t), y: B.y0 - (B.y0 - B.y1) * h };
};

const pad2d = (fn: (t: number) => { x: number; y: number }) =>
  Array.from({ length: 90 }, (_, i) => fn(i / 89))
    .map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x.toFixed(1)} ${p.y.toFixed(1)}`)
    .join(' ');

const lijn = pad2d(punt);
const lijnLaag = pad2d(laag);
const vlak = `${lijn} L${B.x1} ${B.y0} L${B.x0} ${B.y0} Z`;

/* Fasezones: banden tussen de middens van de fasepunten. */
const midden = (a: number, b: number) => (a + b) / 2;
const grenzen = [0, ...FASEN.slice(0, -1).map((f, i) => midden(f.t, FASEN[i + 1].t)), 1];
const ZONES = FASEN.map((f, i) => ({
  fase: f,
  x: X(grenzen[i]),
  breedte: X(grenzen[i + 1]) - X(grenzen[i]),
}));

const regels = FASEN.map(
  (f) => `.curve:has(#sp-${f.id}:checked) .sp-paneel[data-fase="${f.id}"]{display:grid}
.curve:has(#sp-${f.id}:checked) .sp-punt[data-fase="${f.id}"]{--aan:1}
.curve:has(#sp-${f.id}:checked) .sp-knop[data-fase="${f.id}"]{--aan:1}
.curve:has(#sp-${f.id}:checked) .sp-zone[data-fase="${f.id}"]{--aan:1}`,
).join('\n');
---

<div class="curve">
  <div class="sp-plaat">
    <svg class="sp-tekening" viewBox="0 0 730 300" role="img" aria-label="De spanningscurve: van rustig via irritatie en spanning naar escalatie en nasleep. Een tweede, lagere lijn toont dezelfde situatie wanneer er bij irritatie wordt ingegrepen.">
      <defs>
        <linearGradient id="curveverloop" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="var(--oranje-op-wit)" />
          <stop offset="55%" stop-color="var(--paars-op-wit)" />
          <stop offset="100%" stop-color="var(--blauw-op-wit)" />
        </linearGradient>
        <linearGradient id="curvevlak" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--oranje-op-wit)" stop-opacity="0.16" />
          <stop offset="100%" stop-color="var(--oranje-op-wit)" stop-opacity="0" />
        </linearGradient>
      </defs>

      {/* fasebanden: de gekozen fase licht op */}
      {ZONES.map((z) => (
        <g class="sp-zone" data-fase={z.fase.id} data-niveau={z.fase.niveau}>
          <rect x={z.x} y={B.y1 - 26} width={z.breedte} height={B.y0 - B.y1 + 26} class="sp-zone-vlak" />
          <text x={z.x + z.breedte / 2} y={B.y1 - 8} text-anchor="middle" class="sp-zone-label">{z.fase.naam}</text>
        </g>
      ))}

      {/* raster */}
      {[0.25, 0.5, 0.75].map((h) => (
        <line x1={B.x0} y1={B.y0 - (B.y0 - B.y1) * h} x2={B.x1} y2={B.y0 - (B.y0 - B.y1) * h} class="sp-raster" />
      ))}
      <line class="sp-as" x1={B.x0} y1={B.y0} x2={B.x1} y2={B.y0} />

      <path class="sp-vlak" d={vlak} fill="url(#curvevlak)" />

      {/* de afgebogen lijn: wat vroeg ingrijpen doet */}
      <path class="sp-lijn-laag" d={lijnLaag} fill="none" />
      <circle cx={X(1)} cy={laag(1).y} r="6" class="sp-landing" />

      <path class="sp-lijn" d={lijn} fill="none" stroke="url(#curveverloop)" />

      {FASEN.map((f) => {
        const p = punt(f.t);
        return (
          <g class="sp-punt" data-fase={f.id} data-niveau={f.niveau}>
            <line class="sp-steel" x1={p.x} y1={p.y} x2={p.x} y2={B.y0} />
            <circle class="sp-puls" cx={p.x} cy={p.y} r="16" />
            <circle class="sp-ring" cx={p.x} cy={p.y} r="11" />
            <circle class="sp-stip" cx={p.x} cy={p.y} r="5.5" />
          </g>
        );
      })}

      <text class="sp-aslabel" x={B.x0} y={B.y0 + 22}>tijd →</text>
    </svg>

    <p class="sp-legenda">
      <span class="sp-legenda-item"><span class="sp-swatch sp-swatch-hoog" aria-hidden="true"></span> zonder ingrijpen</span>
      <span class="sp-legenda-item"><span class="sp-swatch sp-swatch-laag" aria-hidden="true"></span> vroeg afgebogen: waar de training op mikt</span>
    </p>
  </div>

  <fieldset class="sp-keuze">
    <legend class="alleen-voorlezer">Kies een fase van de spanningscurve</legend>
    {FASEN.map((f, i) => (
      <>
        <input type="radio" name="spanning" id={`sp-${f.id}`} class="sp-radio" checked={i === 1} />
        <label class="sp-knop" for={`sp-${f.id}`} data-fase={f.id} data-niveau={f.niveau}>
          <span class="sp-knop-icoon"><Icoon naam={f.icoon} breedte={18} /></span>
          {f.naam}
        </label>
      </>
    ))}
  </fieldset>

  <div class="sp-panelen">
    {FASEN.map((f) => (
      <div class="sp-paneel" data-fase={f.id} data-niveau={f.niveau}>
        <p class="sp-bovenkop">
          <span class="sp-badge">{NIVEAU_INFO[f.niveau].naam}</span>
          hier ligt het zwaartepunt
        </p>
        <h3>{f.naam}</h3>
        <dl class="sp-lijst">
          <div>
            <dt>Wat je ziet</dt>
            <dd>{f.zieJe}</dd>
          </div>
          <div class="sp-werkt">
            <dt>Wat werkt</dt>
            <dd>{f.werkt}</dd>
          </div>
          <div class="sp-werkt-niet">
            <dt>Wat niet werkt</dt>
            <dd>{f.werktNiet}</dd>
          </div>
        </dl>
        <a href={pad(`/niveaus/${f.niveau}/`)} class="pijllink">
          Zo traint {NIVEAU_INFO[f.niveau].naam.toLowerCase()} hierop
          <span class="pijl" aria-hidden="true">→</span>
        </a>
      </div>
    ))}
  </div>
</div>

<style is:inline set:html={regels}></style>

<style>
  .curve { display: grid; gap: clamp(1.25rem, 1rem + 1.5vw, 2rem); }

  .sp-plaat { display: grid; gap: 0.7rem; }
  .sp-tekening { width: 100%; height: auto; display: block; }

  .sp-raster { stroke: var(--rand-licht); stroke-width: 1; stroke-dasharray: 2 6; }
  .sp-as { stroke: var(--rand-licht); stroke-width: 1.5; }

  .sp-lijn { stroke-width: 5; stroke-linecap: round; }
  .sp-lijn-laag {
    stroke: var(--blauw-op-wit);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 1 9;
    opacity: 0.85;
  }
  .sp-landing { fill: var(--blauw-op-wit); }

  .sp-aslabel, .sp-zone-label {
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 12px;
    fill: var(--tekst-donker-zacht);
  }
  .sp-zone-label {
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 11px;
    opacity: calc(0.55 + var(--aan, 0) * 0.45);
  }

  /* fasebanden */
  .sp-zone { --aan: 0; }
  .sp-zone-vlak {
    fill: var(--niveau-op-wit);
    opacity: calc(0.05 + var(--aan) * 0.09);
    transition: opacity 260ms;
  }

  .sp-punt { --aan: 0; }
  .sp-steel {
    stroke: var(--niveau-op-wit);
    stroke-width: 1.5;
    stroke-dasharray: 3 4;
    opacity: calc(0.25 + var(--aan) * 0.55);
    transition: opacity 220ms;
  }
  .sp-puls {
    fill: var(--niveau-op-wit);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .sp-ring {
    fill: var(--wit);
    stroke: var(--niveau-op-wit);
    stroke-width: 2;
    opacity: calc(0.45 + var(--aan) * 0.55);
    transform-box: fill-box;
    transform-origin: center;
    scale: calc(0.85 + var(--aan) * 0.35);
    transition: opacity 220ms, scale 260ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .sp-stip {
    fill: var(--niveau-op-wit);
    opacity: calc(0.5 + var(--aan) * 0.5);
    transition: opacity 220ms;
  }
  @media (prefers-reduced-motion: no-preference) {
    .sp-puls {
      animation: sp-puls 2.4s ease-out infinite;
      /* onzichtbaar zolang de fase niet gekozen is */
      animation-play-state: running;
      opacity: calc(var(--aan) * 1);
    }
    @keyframes sp-puls {
      0% { scale: 0.5; opacity: calc(var(--aan) * 0.35); }
      70% { scale: 1.4; opacity: 0; }
      100% { scale: 1.4; opacity: 0; }
    }
  }

  .sp-legenda {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin: 0;
    font-size: 0.85rem;
    color: var(--tekst-donker-zacht);
  }
  .sp-legenda-item { display: inline-flex; align-items: center; gap: 0.5rem; }
  .sp-swatch { width: 1.6rem; height: 0; border-top-width: 4px; border-top-style: solid; border-radius: 2px; }
  .sp-swatch-hoog { border-top-color: var(--paars-op-wit); }
  .sp-swatch-laag { border-top-style: dotted; border-top-color: var(--blauw-op-wit); }

  /* ---- knoppenrij ---- */
  .sp-keuze {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .sp-radio { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .sp-knop {
    --aan: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 1rem 0.5rem 0.6rem;
    border-radius: var(--hoek-rond);
    border: 1px solid color-mix(in oklab, var(--niveau-op-wit) calc(22% + var(--aan) * 40%), transparent);
    background: color-mix(in oklab, var(--niveau-op-wit) calc(5% + var(--aan) * 9%), var(--wit));
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--tekst-donker);
    cursor: pointer;
    transition: background 180ms, border-color 180ms;
  }
  .sp-knop-icoon {
    display: grid;
    place-items: center;
    width: 1.75rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--niveau-op-wit);
    color: var(--wit);
    flex: none;
  }
  .sp-radio:focus-visible + .sp-knop { outline: 3px solid var(--focus); outline-offset: 3px; }

  /* ---- panelen ---- */
  .sp-panelen { display: grid; }
  .sp-paneel {
    display: none;
    gap: 0.9rem;
    align-content: start;
    padding: clamp(1.25rem, 1rem + 1vw, 1.85rem);
    background: var(--wit);
    border: 1px solid var(--rand-licht);
    border-radius: var(--hoek);
    border-top: 3px solid var(--niveau-op-wit);
  }
  /* Zonder :has() blijven alle vijf staan: minder mooi, wel volledig leesbaar. */
  @supports not selector(:has(*)) {
    .sp-paneel { display: grid; }
  }

  .sp-bovenkop {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tekst-donker-zacht);
  }
  .sp-badge {
    padding: 0.2rem 0.6rem;
    border-radius: var(--hoek-rond);
    background: color-mix(in oklab, var(--niveau-op-wit) 12%, var(--wit));
    border: 1px solid color-mix(in oklab, var(--niveau-op-wit) 30%, transparent);
    color: var(--niveau-op-wit);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .sp-paneel h3 { margin: 0; }

  .sp-lijst { display: grid; gap: 0.85rem; margin: 0; }
  .sp-lijst > div {
    display: grid;
    gap: 0.2rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--rand-licht);
  }
  .sp-lijst dt {
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tekst-donker-zacht);
  }
  .sp-lijst dd {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--tekst-donker-zacht);
  }
  .sp-werkt { border-left-color: var(--niveau-op-wit) !important; }
  .sp-werkt-niet { border-left-style: dashed !important; }

  @media (min-width: 900px) {
    .curve { grid-template-columns: minmax(0, 1fr) minmax(0, 24rem); align-items: start; }
    .sp-plaat { grid-column: 1; }
    .sp-keuze { grid-column: 1; }
    .sp-panelen { grid-column: 2; grid-row: 1 / 3; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sp-ring, .sp-stip, .sp-steel, .sp-knop, .sp-zone-vlak { transition: none; }
    .sp-puls { animation: none; opacity: 0; }
  }
</style>

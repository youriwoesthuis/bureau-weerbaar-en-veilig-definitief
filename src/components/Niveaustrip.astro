---
import { NIVEAUS, NIVEAU_INFO, MODEL, pad } from '../lib/site';

/**
 * De drie treden van de Weerbaarheidsladder, als strip onder de hero.
 *
 * Hier stond een cijferstrip met vier getallen: 132 trainingen, 44
 * beroepsgroepen, 19 sectoren, 3 niveaus. Hoe groot de catalogus is, is voor
 * een bezoeker niet interessant — en de opdrachtgever wil het er niet zo
 * expliciet op hebben staan. Wat er wél toe doet is het niveausysteem: dat is
 * samen met de specialisatie de reden om voor dit bureau te kiezen.
 * Zie BESLUITEN.md hoofdstuk 1 en 4.
 */
interface Props {
  /** true = de strip valt over de onderrand van de donkere sectie erboven */
  overlappend?: boolean;
}
const { overlappend = false } = Astro.props;

const REGEL: Record<(typeof NIVEAUS)[number], string> = {
  basis: 'Zien aankomen en rustig houden',
  gevorderd: 'Begrenzen als het niet bij één keer blijft',
  expert: 'Vastleggen zodat het blijft staan',
};
---

<div class:list={['niveaustrip', { overlappend }]}>
  <p class="strip-kop">
    <span class="strip-merk">{MODEL.naamHoofdletter}</span>
    <span class="strip-kort">{MODEL.kort}</span>
  </p>
  <ol class="strip-rij">
    {NIVEAUS.map((n, i) => (
      <li>
        <a href={pad(`/niveaus/${n}/`)} class="tredekaart" data-niveau={n}>
          <span class="trede-cijfer" aria-hidden="true">{i + 1}</span>
          <span class="trede-naam">{NIVEAU_INFO[n].naam}</span>
          <span class="trede-regel">{REGEL[n]}</span>
        </a>
      </li>
    ))}
  </ol>
</div>

<style>
  .niveaustrip {
    display: grid;
    gap: 0.9rem;
    background: var(--wit);
    border: 1px solid var(--rand-licht);
    border-radius: var(--hoek);
    padding: clamp(1rem, 0.85rem + 0.8vw, 1.5rem);
    box-shadow: var(--schaduw-md);
  }
  /* De oude cijferstrip viel met een negatieve marge over de onderrand van
     de hero heen: dat bond een donker en een licht vlak aan elkaar. Nu de
     hero zelf licht is, valt er niets meer te binden en botste de strip
     alleen nog met de knoppen erboven. Gewone ruimte dus. */
  .niveaustrip.overlappend { margin-top: clamp(1.75rem, 1rem + 2vw, 3rem); }

  .strip-kop {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.7rem;
    margin: 0;
    padding-inline: 0.25rem;
  }
  .strip-merk {
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--oranje-op-wit);
  }
  .strip-kort { font-size: 0.82rem; color: var(--tekst-donker-zacht); }

  .strip-rij {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  @media (min-width: 720px) { .strip-rij { grid-template-columns: repeat(3, 1fr); } }

  .strip-rij li { display: grid; }

  .tredekaart {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: 0.7rem;
    align-content: start;
    height: 100%;
    padding: 0.85rem 1rem;
    border-radius: calc(var(--hoek) - 3px);
    background: color-mix(in oklab, var(--niveau-op-wit) 6%, var(--wit));
    border: 1px solid color-mix(in oklab, var(--niveau-op-wit) 22%, transparent);
    text-decoration: none;
    color: inherit;
    transition: transform 180ms cubic-bezier(0.2, 0.7, 0.3, 1), background 180ms, border-color 180ms;
  }
  .tredekaart:hover {
    transform: translateY(-2px);
    background: color-mix(in oklab, var(--niveau-op-wit) 11%, var(--wit));
    border-color: color-mix(in oklab, var(--niveau-op-wit) 40%, transparent);
  }

  .trede-cijfer {
    grid-row: 1 / 3;
    align-self: center;
    display: grid;
    place-items: center;
    width: 1.9rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--niveau-op-wit);
    color: var(--wit);
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
  }
  .trede-naam {
    font-family: 'Manrope', system-ui, sans-serif;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.01em;
    color: var(--tekst-donker);
  }
  .trede-regel { font-size: 0.85rem; line-height: 1.4; color: var(--tekst-donker-zacht); }

  @media (prefers-reduced-motion: reduce) {
    .tredekaart { transition: none; }
    .tredekaart:hover { transform: none; }
  }
</style>

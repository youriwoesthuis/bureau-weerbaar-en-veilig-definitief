---
import Icoon from './Icoon.astro';
import { FEITEN, pad } from '../lib/site';

/**
 * De trainingsdag als tijdlijn, met indicatieve dagdelen.
 *
 * Vastgesteld met Youri (26-08-2026):
 * - Dagdelen als etiket (ochtend/middag), géén kloktijden — een tijd op de
 *   site is een toezegging die elke opdracht moet waarmaken.
 * - De acteur "voert de druk niet op". De kern van het oefenen is het
 *   oefengesprek dat je in het moment kunt stilzetten en bijsturen, en
 *   opnieuw kunt doen met andere keuzes. Het aparte drukopbouw-blok is
 *   daarom samengevoegd met het oefenblok.
 * - Wanneer de acteur op de dag aanschuift wisselt per opdracht, dus daar
 *   zegt dit blok niets over.
 * - Expert verloopt echt anders: een werksessie over beleid en teamnorm,
 *   geen oefendag. Vandaar de tweede variant.
 */
interface Props {
  variant?: 'oefen' | 'expert';
}
const { variant = 'oefen' } = Astro.props;

type Blok = {
  dagdeel: string;
  icoon: Parameters<typeof Icoon>[0]['naam'];
  kop: string;
  tekst: string;
  apart?: boolean;
};

const OEFEN: Blok[] = [
  {
    dagdeel: 'Vooraf',
    icoon: 'gesprek',
    kop: 'De intake',
    tekst:
      'Wat er is gebeurd, hoe vaak het voorkomt en wat het team al heeft geprobeerd. Hieruit volgen het niveau en de situaties waarmee geoefend wordt.',
    apart: true,
  },
  {
    dagdeel: 'Ochtend',
    icoon: 'team',
    kop: 'Wat brengt iedereen mee',
    tekst:
      'De dag begint bij de deelnemers zelf: wat maakten zij mee, waar liepen zij vast. Dat bepaalt waar het zwaartepunt van de dag komt te liggen.',
  },
  {
    dagdeel: 'Ochtend',
    icoon: 'signaleren',
    kop: 'Theorie in korte blokken',
    tekst:
      'Geen college. Alleen wat je nodig hebt om de oefening erna te kunnen doen: signalen herkennen, en het verschil tussen gedrag dat je begrijpt en gedrag dat je begrenst.',
  },
  {
    dagdeel: 'Ochtend en middag',
    icoon: 'oefenen',
    kop: 'Oefengesprekken met de acteur',
    tekst:
      'Het grootste deel van de dag. Een gesprek kan in het moment worden stilgezet en bijgestuurd, en dezelfde situatie mag opnieuw: met andere keuzes, tot het gedrag zit.',
  },
  {
    dagdeel: 'Slot van de dag',
    icoon: 'beleid',
    kop: 'Wat gaat maandag anders',
    tekst:
      'De dag eindigt met afspraken die concreet genoeg zijn om na te komen. Wat daarna in de praktijk gebeurt, is waar het echte verschil valt.',
  },
];

/** Expert is een werksessie, geen oefendag. Inhoud komt uit de programma's
 *  van de expert-trainingen zelf; er is niets bij verzonnen. */
const EXPERT: Blok[] = [
  {
    dagdeel: 'Vooraf',
    icoon: 'gesprek',
    kop: 'Intake en werkmateriaal',
    tekst:
      'Wat er is gebeurd, en wat er al ligt: het bestaande beleid, de meldingen en wat het team eerder probeerde. Dat is op deze dag het werkmateriaal.',
    apart: true,
  },
  {
    dagdeel: 'Ochtend',
    icoon: 'signaleren',
    kop: 'Waar staat het team nu',
    tekst:
      'Analyse van meldingsdata, beleid en cultuur: wat wordt er gemeld, wat blijft liggen, en waar wringt het tussen papier en praktijk.',
  },
  {
    dagdeel: 'Ochtend',
    icoon: 'grens',
    kop: 'Het protocol langs de praktijk',
    tekst:
      'Werkt het gedragsprotocol ook op een drukke dinsdagmiddag? Toetsen, aanscherpen, en schrappen wat in de praktijk niet gebruikt wordt.',
  },
  {
    dagdeel: 'Middag',
    icoon: 'team',
    kop: 'Teamnorm en escalatiestructuur',
    tekst:
      'Vastleggen wat wel en niet geaccepteerd wordt, wie wat doet als het misgaat, en hoe collega’s na een ernstig incident worden begeleid.',
  },
  {
    dagdeel: 'Slot van de dag',
    icoon: 'beleid',
    kop: 'Borging en nazorg',
    tekst:
      'Afspraken zo vastleggen dat ze blijven staan als de trainer weg is: de meldroute, de nazorg en het moment waarop het team opnieuw kijkt.',
  },
];

const BLOKKEN = variant === 'expert' ? EXPERT : OEFEN;
---

<div class="dag">
  <ol class="dag-lijn">
    {BLOKKEN.map((b) => (
      <li class:list={['dag-blok', { 'dag-vooraf': b.apart }]}>
        <span class="dag-icoon"><Icoon naam={b.icoon} breedte={20} /></span>
        <span class="dag-fase">{b.dagdeel}</span>
        <h3 class="h4">{b.kop}</h3>
        <p>{b.tekst}</p>
      </li>
    ))}
  </ol>

  {variant === 'expert' ? (
    <p class="dag-voet">
      Niveau expert duurt {FEITEN.duur} en telt {FEITEN.groepsgrootteExpert}: het
      is een werksessie met de mensen die over beleid gaan, geen oefendag. De
      dagdelen zijn indicatief.
    </p>
  ) : (
    <p class="dag-voet">
      Elke training duurt {FEITEN.duur} en telt {FEITEN.groepsgrootte}. De
      dagdelen zijn indicatief: het ritme ligt vast, de casuïstiek komt uit
      jullie eigen meldingen. <a href={pad('/sectoren/')}>Zoek je beroep op</a> om
      te zien wat er dan op het programma staat.
    </p>
  )}
</div>

<style>
  .dag { display: grid; gap: clamp(1.25rem, 1rem + 1vw, 1.75rem); }

  .dag-lijn {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: clamp(0.75rem, 0.5rem + 1vw, 1.1rem);
  }
  @media (min-width: 700px) { .dag-lijn { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1080px) { .dag-lijn { grid-template-columns: repeat(5, 1fr); } }

  .dag-blok {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.45rem;
    padding: clamp(1rem, 0.85rem + 0.6vw, 1.35rem);
    background: var(--wit);
    border: 1px solid var(--rand-licht);
    border-radius: var(--hoek);
    border-top: 3px solid var(--oranje-op-wit);
  }
  /* De intake hoort niet bij de dag zelf; die staat ervoor. */
  .dag-vooraf {
    background: var(--mist-50);
    border-top-color: var(--blauw-op-wit);
    border-style: dashed;
  }

  /* Het verbindingslijntje tussen de blokken, alleen op brede schermen. */
  @media (min-width: 1080px) {
    .dag-blok:not(:last-child)::after {
      content: '';
      position: absolute;
      top: -1px;
      right: calc(-1 * clamp(0.75rem, 0.5rem + 1vw, 1.1rem) - 1px);
      width: clamp(0.75rem, 0.5rem + 1vw, 1.1rem);
      height: 3px;
      background: var(--rand-licht);
    }
  }

  .dag-icoon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    aspect-ratio: 1;
    border-radius: 0.55rem;
    background: color-mix(in oklab, var(--oranje-op-wit) 12%, var(--wit));
    border: 1px solid color-mix(in oklab, var(--oranje-op-wit) 26%, transparent);
    color: var(--oranje-op-wit);
  }
  .dag-vooraf .dag-icoon {
    background: color-mix(in oklab, var(--blauw-op-wit) 12%, var(--wit));
    border-color: color-mix(in oklab, var(--blauw-op-wit) 26%, transparent);
    color: var(--blauw-op-wit);
  }

  .dag-fase {
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tekst-donker-zacht);
  }
  .dag-blok h3 { margin: 0; }
  .dag-blok p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--tekst-donker-zacht);
  }

  .dag-voet {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--tekst-donker-zacht);
  }
  .dag-voet a { color: var(--oranje-op-wit); padding-block: 0.3rem; }
</style>

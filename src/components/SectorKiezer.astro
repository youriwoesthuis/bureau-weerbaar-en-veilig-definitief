---
import { getCollection } from 'astro:content';
import { pad } from '../lib/site';

/**
 * Kies een sector, zie meteen de beroepsgroepen.
 * Werkt zonder JavaScript: radioknoppen plus :has(). Elke beroepsgroep
 * staat in de HTML, dus ook crawlers en voorlezers zien alles.
 */

const sectoren = (await getCollection('sectoren')).sort((a, b) =>
  a.data.naam.localeCompare(b.data.naam, 'nl'),
);
const beroepsgroepen = await getCollection('beroepsgroepen');

// De kiezer opent op de grootste sector, niet op de alfabetisch eerste:
// een paneel met acht beroepsgroepen laat direct zien wat het aanbod is.
const grootste = [...sectoren]
  .map((s) => ({ slug: s.data.slug, n: beroepsgroepen.filter((b) => b.data.sector === s.data.slug).length }))
  .sort((a, b) => b.n - a.n)[0]?.slug;

const perSector = sectoren.map((s) => ({
  ...s.data,
  groepen: beroepsgroepen
    .filter((b) => b.data.sector === s.data.slug)
    .sort((a, b) => a.data.naam.localeCompare(b.data.naam, 'nl')),
}));

// Eén CSS-regel per sector om het juiste paneel te tonen. Zonder deze
// regels valt de kiezer terug op "alles zichtbaar" — minder mooi, wel
// volledig bruikbaar.
//
// De opmaak van de actieve chip staat hier bewust níét bij: die gaat via
// `.chip-radio:checked + .chip` in het scoped stijlblok hieronder. Elke
// radioknop staat direct voor zijn eigen label, dus dat kan met een
// simpele buurselector — en die vecht niet met Astro's scoping.
const regels = perSector
  .map((s) => `.kiezer:has(#sector-${s.slug}:checked) .paneel[data-sector="${s.slug}"]{display:grid}`)
  .join('\n');
---

<div class="kiezer">
  <fieldset class="kiezer-keuze">
    <legend class="bovenkop">Kies je sector</legend>
    <div class="sectorlijst">
      {perSector.map((s) => (
        <>
          <input
            type="radio"
            name="sector"
            id={`sector-${s.slug}`}
            class="chip-radio"
            checked={s.slug === grootste}
          />
          <label for={`sector-${s.slug}`} class="chip">
            <span class="chip-naam">{s.naam}</span>
            <span class="chip-aantal">{s.groepen.length}</span>
          </label>
        </>
      ))}
    </div>
  </fieldset>

  <div class="kiezer-uitkomst">
    {perSector.map((s) => (
      <div class="paneel" data-sector={s.slug}>
        <div class="paneel-kop">
          <h3>{s.naam}</h3>
          <p class="paneel-aantal">
            {s.groepen.length} {s.groepen.length === 1 ? 'beroepsgroep' : 'beroepsgroepen'}
            · {s.groepen.length * 3} trainingen
          </p>
        </div>
        <ul class="groeplijst">
          {s.groepen.map((b) => (
            <li>
              <a href={pad(`/sectoren/${s.slug}/${b.data.slug}/`)}>
                <span>{b.data.naam}</span>
                <span class="pijl" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
        <a href={pad(`/sectoren/${s.slug}/`)} class="pijllink paneel-link">
          Alles over agressietraining in de sector {s.naam.toLowerCase()}
          <span class="pijl" aria-hidden="true">→</span>
        </a>
      </div>
    ))}
  </div>
</div>

{/* is:inline omdat de inhoud pas tijdens het bouwen ontstaat, en omdat
    deze regels ongescoped moeten blijven — ze verwijzen naar de id's van
    de radioknoppen. */}
<style is:inline set:html={regels}></style>

<style>
  /* Sectoren boven, uitkomst eronder. Naast elkaar werkte niet: een lijst
     van negentien rijen is ruim twee keer zo hoog als het paneel, dus bleef
     er rechts een groot leeg vlak staan. Zo staat de keuze bovendien direct
     boven het resultaat dat erbij hoort. */
  .kiezer {
    display: grid;
    gap: clamp(1.25rem, 1rem + 1.5vw, 2rem);
  }

  .kiezer-keuze { border: 0; padding: 0; margin: 0; min-width: 0; }
  .kiezer-keuze legend { padding: 0; margin-bottom: 1rem; }

  /* Elke cel exact even breed. Dat is het verschil met een rij pillen die
     op woordlengte afbreekt: negentien namen van sterk wisselende lengte
     vielen daar in rijen van twee en drie met een rafelige rechterrand, en
     de gekozen sector belandde willekeurig ergens onderin. In een raster
     lopen de kolommen en rijen door. */
  .sectorlijst {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    border: 1px solid var(--rand);
    border-radius: var(--hoek);
    overflow: hidden;
    /* Zelfde kleur als de cellen. Negentien is niet deelbaar door het
       aantal kolommen, dus de laatste rij houdt lege plekken over; die
       moeten wegvallen tegen de rest in plaats van als grijs blok op te
       vallen. Daarom worden de scheidingslijnen niet met de achtergrond
       getekend maar met een schaduw op de cellen zelf. */
    background: var(--inkt-850);
  }

  /* De radioknop blijft bedienbaar met het toetsenbord, alleen onzichtbaar. */
  .chip-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .chip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.45rem 0.9rem;
    background: var(--inkt-850);
    color: var(--tekst-zacht);
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    user-select: none;
    border-left: 3px solid transparent;
    /* De scheidingslijnen. Een schaduw neemt geen ruimte in, dus de
       buitenste lijnen vallen weg tegen de rand van het kader. */
    box-shadow: 1px 0 0 var(--rand), 0 1px 0 var(--rand);
    transition: background 150ms, color 150ms, border-color 150ms, padding-left 160ms;
  }
  .chip-naam { min-width: 0; }
  .chip-aantal {
    flex: none;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    color: var(--tekst-gedempt);
  }

  .chip:hover {
    background: var(--inkt-800);
    color: var(--tekst);
    border-left-color: var(--oranje-500);
    padding-left: 1.2rem;
  }
  .chip-radio:focus-visible + .chip { outline: 3px solid var(--amber-400); outline-offset: -3px; }

  /* De gekozen sector. Donkere tekst op het oranje verloop van het logo. */
  .chip-radio:checked + .chip {
    background: var(--verloop-warm);
    color: #1a0d00;
    border-left-color: transparent;
    font-weight: 600;
    padding-left: 0.9rem;
  }
  .chip-radio:checked + .chip .chip-aantal { color: #3d2400; }
  .chip-radio:checked + .chip:hover { color: #1a0d00; padding-left: 0.9rem; }

  .kiezer-uitkomst {
    background: var(--inkt-850);
    border: 1px solid var(--rand);
    border-radius: var(--hoek);
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    min-height: 20rem;
  }

  /* Zonder :has() blijven alle panelen staan: minder mooi, wel volledig. */
  .paneel { display: grid; gap: 1.25rem; }
  @supports selector(:has(*)) {
    .paneel { display: none; }
  }

  .paneel-kop { display: grid; gap: 0.3rem; }
  .paneel-kop h3 { font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.9rem); }
  .paneel-aantal {
    font-size: 0.875rem;
    color: var(--tekst-gedempt);
    font-family: 'Manrope', system-ui, sans-serif;
  }

  .groeplijst {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    border: 1px solid var(--rand);
    border-radius: var(--hoek);
    overflow: hidden;
    /* Zie de toelichting bij .sectorlijst: het aantal beroepsgroepen past
       zelden precies in het aantal kolommen. */
    background: var(--inkt-850);
  }
  @media (min-width: 620px) {
    .groeplijst { grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); }
  }
  /* Zonder deze twee regels rekt een cel niet mee wanneer de buurcel twee
     regels wordt, en zie je de achtergrond van het raster als grijs gat
     onder de kortere naam. */
  .groeplijst li { display: grid; }
  .groeplijst a {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 3rem;
    padding: 0.7rem 0.85rem;
    background: var(--inkt-850);
    color: var(--tekst-zacht);
    text-decoration: none;
    font-size: 0.95rem;
    box-shadow: 1px 0 0 var(--rand), 0 1px 0 var(--rand);
    transition: background 150ms, color 150ms, padding-left 180ms;
  }
  .groeplijst a .pijl {
    color: var(--oranje-500);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 180ms, transform 180ms;
  }
  .groeplijst a:hover {
    background: var(--inkt-800);
    color: var(--tekst);
    padding-left: 1.15rem;
  }
  .groeplijst a:hover .pijl { opacity: 1; transform: none; }

  .paneel-link { font-size: 0.95rem; }

  /* ----------------------------------------------------------------------
     Op een lichte sectie. De kiezer staat op de homepage binnen .op-licht,
     en zonder deze regels erft hij de kleuren voor donkere achtergronden:
     lichtblauwe chips op bijna-wit en donkere koppen op een donker paneel.
     ---------------------------------------------------------------------- */
  :global(.op-licht) .sectorlijst,
  :global(.op-wit) .sectorlijst { background: var(--wit); border-color: var(--rand-licht); }
  :global(.op-licht) .chip,
  :global(.op-wit) .chip { box-shadow: 1px 0 0 var(--rand-licht), 0 1px 0 var(--rand-licht); }

  :global(.op-licht) .chip,
  :global(.op-wit) .chip { background: var(--wit); color: var(--tekst-donker-zacht); }
  :global(.op-licht) .chip:hover,
  :global(.op-wit) .chip:hover {
    background: var(--mist-50);
    color: var(--tekst-donker);
    border-left-color: var(--oranje-op-wit);
  }
  :global(.op-licht) .chip-aantal,
  :global(.op-wit) .chip-aantal { color: var(--tekst-donker-zacht); }
  :global(.op-licht) .chip-radio:checked + .chip .chip-aantal,
  :global(.op-wit) .chip-radio:checked + .chip .chip-aantal { color: #3d2400; }
  :global(.op-licht) .chip-radio:focus-visible + .chip,
  :global(.op-wit) .chip-radio:focus-visible + .chip { outline-color: var(--blauw-op-wit); }

  :global(.op-licht) .kiezer-uitkomst,
  :global(.op-wit) .kiezer-uitkomst { background: var(--wit); border-color: var(--rand-licht); }

  :global(.op-licht) .paneel-aantal,
  :global(.op-wit) .paneel-aantal { color: var(--tekst-donker-zacht); }

  :global(.op-licht) .groeplijst,
  :global(.op-wit) .groeplijst { background: var(--wit); border-color: var(--rand-licht); }
  :global(.op-licht) .groeplijst a,
  :global(.op-wit) .groeplijst a { box-shadow: 1px 0 0 var(--rand-licht), 0 1px 0 var(--rand-licht); }
  :global(.op-licht) .groeplijst a,
  :global(.op-wit) .groeplijst a { background: var(--wit); color: var(--tekst-donker-zacht); }
  :global(.op-licht) .groeplijst a .pijl,
  :global(.op-wit) .groeplijst a .pijl { color: var(--oranje-op-wit); }
  :global(.op-licht) .groeplijst a:hover,
  :global(.op-wit) .groeplijst a:hover { background: var(--mist-50); color: var(--tekst-donker); }
</style>

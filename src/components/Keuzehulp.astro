---
import { NIVEAU_INFO, NIVEAUS, pad } from '../lib/site';

/**
 * Niveau-keuzehulp. Drie vragen; elk antwoord hoort bij een niveau, en de
 * uitkomst is het hóógste niveau dat is aangevinkt. Dat is bewust: wie op
 * één punt bij expert uitkomt, heeft aan basis niet genoeg.
 *
 * Herbouwd op 31-08-2026 na een opmerking van Youri: de vorige versie liet
 * twee van de drie niveaus verdwijnen zodra je antwoordde, en dan valt er
 * niets meer te vergelijken. Nu blijven alle drie staan en markeren de
 * antwoorden er één. Je ziet dus altijd het hele veld, met een richting erin.
 *
 * Werkt zonder JavaScript. Drie CSS-regels in plaats van een regel per
 * combinatie (dat zouden er 27 zijn): staat er ergens een expert-antwoord
 * aan dan expert, anders gevorderd als dat aanstaat, anders basis. Ze zetten
 * `--aan` op 1 bij de gekozen kaart en tonen de bijbehorende zin in de
 * statusregel.
 */

const VRAGEN = [
  {
    id: 'ervaring',
    vraag: 'Heeft het team eerder een agressietraining gehad?',
    antwoorden: [
      { niveau: 'basis', tekst: 'Nee, of zo lang geleden dat het weggezakt is' },
      { niveau: 'gevorderd', tekst: 'Ja, de basis zit er wel in' },
      { niveau: 'expert', tekst: 'Ja, meerdere keren: we lopen nu tegen de organisatie aan' },
    ],
  },
  {
    id: 'aanleiding',
    vraag: 'Wat is de aanleiding om nu te trainen?',
    antwoorden: [
      { niveau: 'basis', tekst: 'Medewerkers weten niet goed wat te doen als de spanning oploopt' },
      { niveau: 'gevorderd', tekst: 'Situaties lopen uit de hand, ook als er netjes wordt gede-escaleerd' },
      { niveau: 'expert', tekst: 'We moeten vastleggen wat de norm is, hoe we melden en wie nazorg doet' },
    ],
  },
  {
    id: 'deelnemers',
    vraag: 'Wie gaat de training volgen?',
    antwoorden: [
      { niveau: 'basis', tekst: 'Uitvoerende medewerkers met klant- of cliëntcontact' },
      { niveau: 'gevorderd', tekst: 'Medewerkers die structureel met zware situaties werken' },
      { niveau: 'expert', tekst: 'Leidinggevenden, coördinatoren of preventiemedewerkers' },
    ],
  },
];

/* Bewust ongescopeerd: :has() moet vanaf de wrapper naar de kaarten kunnen
   kijken, en Astro zou de selector anders per element herschrijven. */
const regels = `
.keuzehulp:has(input[value="expert"]:checked) .niveaukaart[data-niveau="expert"],
.keuzehulp:has(input[value="gevorderd"]:checked):not(:has(input[value="expert"]:checked)) .niveaukaart[data-niveau="gevorderd"],
.keuzehulp:not(:has(input[value="gevorderd"]:checked)):not(:has(input[value="expert"]:checked)) .niveaukaart[data-niveau="basis"]{--aan:1}
.keuzehulp:has(input[value="expert"]:checked) .uitkomstzin[data-niveau="expert"],
.keuzehulp:has(input[value="gevorderd"]:checked):not(:has(input[value="expert"]:checked)) .uitkomstzin[data-niveau="gevorderd"],
.keuzehulp:not(:has(input[value="gevorderd"]:checked)):not(:has(input[value="expert"]:checked)) .uitkomstzin[data-niveau="basis"]{display:block}
`;
---

<div class="keuzehulp">
  <div class="vragen">
    {VRAGEN.map((v, i) => (
      <fieldset class="vraag">
        <legend>
          <span class="vraag-nummer" aria-hidden="true">{i + 1}</span>
          {v.vraag}
        </legend>
        <div class="antwoorden">
          {v.antwoorden.map((a, j) => (
            <>
              <input
                type="radio"
                name={v.id}
                id={`${v.id}-${j}`}
                value={a.niveau}
                class="antwoord-radio"
                checked={j === 0}
              />
              <label for={`${v.id}-${j}`} class="antwoord">{a.tekst}</label>
            </>
          ))}
        </div>
      </fieldset>
    ))}
  </div>

  {/* Eén zin die meebeweegt met de antwoorden. Alleen hier staat de uitkomst
      in woorden, zodat een schermlezer niet drie keer een aanbeveling hoort. */}
  <p class="uitkomstregel" role="status">
    {NIVEAUS.map((n) => (
      <span class="uitkomstzin" data-niveau={n}>
        Je antwoorden wijzen naar <strong>niveau {NIVEAU_INFO[n].naam.toLowerCase()}</strong>.
        De andere twee blijven hiernaast staan, zodat je zelf kunt vergelijken.
      </span>
    ))}
  </p>

  <div class="niveaukaarten">
    {NIVEAUS.map((n) => {
      const info = NIVEAU_INFO[n];
      return (
        <article class="niveaukaart" data-niveau={n}>
          <p class="kaart-vlag" aria-hidden="true">Past bij je antwoorden</p>
          <h3>Niveau {info.naam.toLowerCase()}</h3>
          <p class="kaart-kort">{info.kort}</p>
          <dl class="kaart-feiten">
            <dt>Voor wie</dt>
            <dd>{info.voorWie}</dd>
            <dt>Wat je doet</dt>
            <dd>{info.omschrijving}</dd>
          </dl>
          <a href={pad(`/niveaus/${n}/`)} class="pijllink kaart-link">
            Bekijk niveau {info.naam.toLowerCase()}
            <span class="pijl" aria-hidden="true">→</span>
          </a>
        </article>
      );
    })}
  </div>

  <p class="keuze-noot">
    Dit is een richting, geen diagnose. Bureau Weerbaar en Veilig kijkt er bij
    de intake samen met je naar, ook als dat een ander niveau oplevert dan
    hier staat.
  </p>
</div>

<style is:inline set:html={regels}></style>

<style>
  .keuzehulp { display: grid; gap: clamp(1.5rem, 1rem + 2vw, 2.25rem); }

  /* ---- De drie vragen ---- */
  .vragen {
    display: grid;
    gap: clamp(1.25rem, 1rem + 1vw, 1.75rem);
  }
  @media (min-width: 900px) {
    .vragen { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .vraag { border: 0; padding: 0; margin: 0; min-width: 0; display: grid; gap: 0.7rem; align-content: start; }
  .vraag legend {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    padding: 0;
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--tekst-donker);
  }
  .vraag-nummer {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
    border-radius: 50%;
    background: var(--oranje-op-wit);
    color: var(--wit);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .antwoorden { display: grid; gap: 0.4rem; align-content: start; }
  .antwoord-radio { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }

  .antwoord {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 2.9rem;
    padding: 0.6rem 0.9rem;
    background: var(--wit);
    border: 1px solid var(--rand-licht);
    border-radius: var(--hoek);
    color: var(--tekst-donker-zacht);
    font-size: 0.92rem;
    line-height: 1.4;
    cursor: pointer;
    transition: border-color 150ms, background 150ms, color 150ms;
  }
  /* Het bolletje links is puur visueel; de radioknop zelf stuurt alles aan. */
  .antwoord::before {
    content: '';
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
    border-radius: 50%;
    border: 2px solid var(--rand-licht);
    transition: border-color 150ms, box-shadow 150ms;
  }
  .antwoord:hover { border-color: var(--tekst-donker-zacht); color: var(--tekst-donker); }
  .antwoord-radio:focus-visible + .antwoord { outline: 3px solid var(--focus); outline-offset: 2px; }
  .antwoord-radio:checked + .antwoord {
    border-color: var(--oranje-op-wit);
    background: color-mix(in oklab, var(--oranje-op-wit) 7%, var(--wit));
    color: var(--tekst-donker);
    font-weight: 600;
  }
  .antwoord-radio:checked + .antwoord::before {
    border-color: var(--oranje-op-wit);
    box-shadow: inset 0 0 0 3px var(--wit), inset 0 0 0 1rem var(--oranje-op-wit);
  }

  /* ---- De uitkomst in één zin ---- */
  .uitkomstregel {
    margin: 0;
    padding: 0.85rem 1.1rem;
    background: var(--wit);
    border: 1px solid var(--rand-licht);
    border-left: 3px solid var(--oranje-op-wit);
    border-radius: var(--hoek);
    color: var(--tekst-donker-zacht);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .uitkomstregel strong { color: var(--tekst-donker); }
  /* Zonder :has() staan alle drie de zinnen er: minder mooi, wel leesbaar. */
  .uitkomstzin { display: block; }
  @supports selector(:has(*)) {
    .uitkomstzin { display: none; }
  }

  /* ---- De drie niveaus naast elkaar ---- */
  .niveaukaarten {
    display: grid;
    gap: clamp(0.75rem, 0.6rem + 0.6vw, 1.1rem);
  }
  @media (min-width: 900px) {
    .niveaukaarten { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .niveaukaart {
    --aan: 0;
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: clamp(1.1rem, 0.9rem + 0.7vw, 1.5rem);
    background: color-mix(in oklab, var(--niveau-op-wit) calc(var(--aan) * 6%), var(--wit));
    border: 1px solid var(--rand-licht);
    border-top: calc(2px + var(--aan) * 3px) solid var(--niveau-op-wit);
    border-radius: var(--hoek);
    transition: background 180ms, border-top-width 180ms;
  }

  /* De vlag reserveert altijd ruimte, zodat de drie kaarten uitgelijnd
     blijven; alleen de gekozen kaart laat hem zien. aria-hidden, want de
     statusregel hierboven zegt het al in woorden. */
  .kaart-vlag {
    justify-self: start;
    margin: 0;
    padding: 0.28rem 0.6rem;
    /* Als chip in plaats van losse tekst: het label stond in de niveaukleur
       op een licht getinte kaart en haalde daarmee 4,04:1, te weinig voor
       kleine tekst. Wit op de volle niveaukleur haalt ruim 5:1. */
    background: var(--niveau-op-wit);
    border-radius: var(--hoek);
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--wit);
    opacity: var(--aan);
    transition: opacity 180ms;
  }

  .niveaukaart h3 {
    margin: 0;
    font-size: clamp(1.15rem, 1.05rem + 0.4vw, 1.35rem);
    color: var(--tekst-donker);
  }
  .kaart-kort {
    margin: 0;
    font-family: 'Manrope', system-ui, sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--niveau-op-wit);
  }

  .kaart-feiten { margin: 0.35rem 0 0; display: grid; gap: 0.15rem; }
  .kaart-feiten dt {
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--tekst-donker-zacht);
  }
  .kaart-feiten dd {
    margin: 0 0 0.6rem;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--tekst-donker-zacht);
  }
  .kaart-feiten dd:last-of-type { margin-bottom: 0; }

  .kaart-link { justify-self: start; margin-top: 0.5rem; }

  .keuze-noot {
    margin: 0;
    max-width: 68ch;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--tekst-donker-zacht);
  }

  @media (prefers-reduced-motion: reduce) {
    .antwoord, .niveaukaart, .kaart-vlag { transition: none; }
  }
</style>

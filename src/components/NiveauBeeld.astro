---
import type { Niveau } from '../lib/site';

/**
 * De drie treden met het huidige niveau opgelicht. Vult de rechterhelft
 * van de kop op een trainingspagina en laat in één blik zien waar deze
 * training in de leerlijn staat — zonder dat er een woord bij hoeft.
 *
 * Dezelfde vormentaal als de illustratie op de homepage.
 */
interface Props {
  /** Laat één trede oplichten. Weglaten op een pagina die over alle drie
   *  de niveaus gaat — dan staat de hele ladder aan. */
  huidig?: Niveau;
}
const { huidig } = Astro.props;

const TREDEN = [
  { niveau: 'basis' as const, x: 12, y: 132, h: 92, kleur: ['#f6a03a', '#e87e12'] },
  { niveau: 'gevorderd' as const, x: 106, y: 86, h: 138, kleur: ['#c49bb0', '#8b5e76'] },
  { niveau: 'expert' as const, x: 200, y: 34, h: 190, kleur: ['#8fa2e6', '#284191'] },
];
---

<svg class="niveaubeeld" viewBox="0 0 292 240" fill="none" aria-hidden="true" focusable="false">
  <defs>
    {TREDEN.map((t) => (
      <linearGradient id={`nb-${t.niveau}`} x1="0" y1="0" x2="0.3" y2="1">
        <stop offset="0%" stop-color={t.kleur[0]} />
        <stop offset="100%" stop-color={t.kleur[1]} />
      </linearGradient>
    ))}
    <radialGradient id="nb-gloed" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0%" stop-color="#f18816" stop-opacity="0.22" />
      <stop offset="100%" stop-color="#f18816" stop-opacity="0" />
    </radialGradient>
  </defs>

  <circle cx="146" cy="110" r="120" fill="url(#nb-gloed)" />

  {TREDEN.map((t) => {
    // Zonder `huidig` staat alles aan: de pagina gaat dan over alle drie.
    const actief = !huidig || t.niveau === huidig;
    return (
      <g class:list={['trede', { 'trede-actief': actief }]}>
        <rect
          x={t.x}
          y={t.y}
          width="80"
          height={t.h}
          rx="14"
          fill={`url(#nb-${t.niveau})`}
        />
        <path
          d={`M${t.x + 20} ${t.y + 26} L${t.x + 40} ${t.y + 43} L${t.x + 60} ${t.y + 26} L${t.x + 60} ${t.y + 39} L${t.x + 40} ${t.y + 56} L${t.x + 20} ${t.y + 39} Z`}
          fill="#14100a"
          opacity="0.34"
        />
        {huidig && actief && (
          <circle cx={t.x + 40} cy={t.y - 18} r="9" fill="#f18816" />
        )}
      </g>
    );
  })}
</svg>

<style>
  .niveaubeeld { width: 100%; height: auto; }

  /* De niet-actieve treden treden terug, zodat het huidige niveau eruit
     springt zonder dat de andere twee verdwijnen — ze horen bij het
     verhaal van de leerlijn. */
  .trede { opacity: 0.34; transition: opacity 250ms ease; }
  .trede-actief { opacity: 1; }

  @media (prefers-reduced-motion: no-preference) {
    .trede-actief { animation: trede-op 620ms cubic-bezier(0.2, 0.8, 0.3, 1) both; }
  }
  @keyframes trede-op {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
</style>

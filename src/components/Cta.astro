---
import { SITE, pad } from '../lib/site';

/**
 * De afsluiting van elke pagina. Naar het voorbeeld van agressievisie.nl
 * een vol verloopblok met royale hoeken, in plaats van weer een donkere
 * sectie — anders lopen alle secties visueel in elkaar over.
 */
interface Props {
  kop?: string;
  tekst?: string;
}
const {
  kop = 'Overleggen over wat uw team nodig heeft?',
  tekst = 'Vertel wat er speelt. Bureau Weerbaar en Veilig denkt mee over beroepsgroep, niveau en aanpak — en zegt het ook als een training niet het antwoord is.',
} = Astro.props;
---

<section class="cta-sectie">
  <div class="omhulsel">
    <div class="cta-band">
      <div class="cta-tekst">
        <h2>{kop}</h2>
        <p>{tekst}</p>
      </div>
      <div class="cta-knoppen">
        <a href={pad('/contact/')} class="knop cta-knop-hoofd">
          Offerte aanvragen
          <span class="pijl" aria-hidden="true">→</span>
        </a>
        <a href={`tel:${SITE.telefoonUri}`} class="knop cta-knop-tweede">Bel {SITE.telefoon}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-sectie { padding-block: clamp(3rem, 2rem + 3vw, 5rem); background: var(--inkt-900); }

  .cta-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    padding: clamp(1.75rem, 1.2rem + 2.4vw, 2.9rem);
    border-radius: var(--hoek-groot);
    background: var(--verloop-warm);
    /* Donkere tekst op het oranje verloop: 8,9:1 tegen de lichtste stop. */
    color: #2a1600;
  }

  .cta-tekst { max-width: 34rem; display: grid; gap: 0.5rem; }
  .cta-band h2 { color: #1f1000; }
  .cta-band p { color: #3a2100; font-size: 1.02rem; line-height: 1.55; }

  .cta-knoppen { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  /* Op het oranje vlak werkt de standaardknop niet: die is zelf oranje.
     Daarom hier een donkere hoofdknop en een omlijnde tweede. */
  .cta-knop-hoofd {
    background: #1f1000;
    color: #fff8ef;
    border-color: #1f1000;
  }
  .cta-knop-hoofd:hover { box-shadow: 0 10px 26px rgba(0, 0, 0, 0.28); }

  .cta-knop-tweede {
    background: rgba(255, 255, 255, 0.55);
    border-color: #7a4a06;
    color: #2a1600;
  }
  .cta-knop-tweede:hover { background: rgba(255, 255, 255, 0.8); box-shadow: none; }
</style>

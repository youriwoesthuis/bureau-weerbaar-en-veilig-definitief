const { naam, breedte = 22, class: klasse = '' } = Astro.props;
const paden = PADEN[naam] ?? PADEN.vinkje;
---

<svg
  class={klasse}
  width={breedte}
  height={breedte}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {paden.map((d) => <path d={d} />)}
</svg>

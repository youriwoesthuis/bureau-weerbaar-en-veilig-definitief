---
import { pad } from '../lib/site';

const huidig = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/').replace(/\/{2,}/g, '/');

const menu = [
  // "Voor wie" — keuze van Youri, 26-08-2026. Menselijker dan
  // "Beroepsgroepen", en het menu is niet waar de vindbaarheid vandaan komt;
  // de pagina erachter blijft op beroepsgroep en sector geordend.
  // "Trainingen" staat er bewust niet bij — die lijst blijft bestaan en
  // vindbaar, maar bezoekers gaan via beroepsgroep of niveau.
  { naam: 'Home', url: pad('/') },
  { naam: 'Voor wie', url: pad('/sectoren/') },
  { naam: 'Niveaus', url: pad('/niveaus/') },
  { naam: 'Aanpak', url: pad('/aanpak/') },
  { naam: 'Over ons', url: pad('/over-ons/') },
];

// Home is exact-match: anders zou startsWith('/') op elke pagina aanslaan
// en stonden er twee items tegelijk als "actief" gemarkeerd.
const actief = (url: string) =>
  url === pad('/') ? huidig === pad('/') : huidig.startsWith(url);
---

<a class="springlink" href="#hoofd">Naar de hoofdinhoud</a>

<header class="kop">
  <!-- Voortgangsbalk: laat op lange pagina's zien hoe ver je bent. Puur CSS. -->
  <div class="voortgang" aria-hidden="true"></div>

  <div class="omhulsel kop-binnen">
    {/* Het echte logobestand, niet een nagetekende versie. De witte
        variant heeft een wit woordmerk en hoort dus op het donkere vlak
        van deze kop. Vaste breedte en hoogte, zodat de regel niet
        verspringt terwijl de afbeelding laadt. */}
    <a href={pad('/')} class="merk" aria-label="Bureau Weerbaar en Veilig, naar de homepage">
      <img
        src={pad('/images/logo/logo-origineel-wit.png')}
        alt=""
        width="1044"
        height="205"
        class="merk-logo"
        fetchpriority="high"
      />
    </a>

    <input type="checkbox" id="menu-schakelaar" class="menu-schakelaar" />
    <label for="menu-schakelaar" class="menu-knop">
      <span class="menu-streep" aria-hidden="true"></span>
      <span class="menu-label-open">Menu</span>
      <span class="menu-label-dicht">Sluiten</span>
    </label>

    <nav class="navigatie" aria-label="Hoofdmenu">
      <ul>
        {menu.map((item) => (
          <li>
            <a href={item.url} aria-current={actief(item.url) ? 'page' : undefined}>{item.naam}</a>
          </li>
        ))}
      </ul>
      <a href={pad('/contact/')} class="knop kop-knop">
        Offerte aanvragen
        <span class="pijl" aria-hidden="true">→</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .kop {
    /* Donker vlak: daar is de lichte focuskleur de leesbare. */
    --focus: var(--amber-400);
    position: sticky;
    top: 0;
    z-index: 50;
    /* Niet color-mix(): dat rekent uit tot een oklab()-waarde, en dan meet
       de contrastcontrole deze balk als een licht vlak.
       0.94 en niet 0.82: bij 82% bleef tekst die onder de balk doorscrolt er
       half doorheen zichtbaar, en dat las als slordig (Gemini-review). */
    background: rgba(18, 18, 22, 0.94);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--rand);
  }

  .voortgang {
    position: absolute;
    inset: auto 0 -1px 0;
    height: 2px;
    background: var(--verloop-merk);
    transform-origin: left;
    transform: scaleX(0);
  }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .voortgang {
        animation: voortgang linear both;
        animation-timeline: scroll(root block);
      }
    }
  }

  .kop-binnen {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
  }

  .merk {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--tekst);
    flex: none;
  }
  .merk-logo {
    /* 205px hoog in het bestand; hier op 34px zodat het scherp blijft. */
    height: 34px;
    width: auto;
  }
  @media (max-width: 520px) {
    .merk-logo { height: 28px; }
  }

  .navigatie {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 1.6vw, 1.6rem);
  }
  .navigatie ul {
    display: flex;
    align-items: center;
    gap: clamp(0.25rem, 1.2vw, 0.6rem);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .navigatie a:not(.knop) {
    display: block;
    padding: 0.6rem 0.7rem;
    color: var(--tekst-zacht);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    border-radius: var(--hoek);
    position: relative;
    transition: color 160ms;
  }
  .navigatie a:not(.knop)::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.35rem;
    height: 2px;
    background: var(--oranje-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .navigatie a:not(.knop):hover { color: var(--tekst); }
  .navigatie a:not(.knop):hover::after { transform: scaleX(1); }
  .navigatie a[aria-current='page'] { color: var(--tekst); }
  .navigatie a[aria-current='page']::after { transform: scaleX(1); }

  .kop-knop { min-height: 2.6rem; padding: 0.5rem 1.05rem; font-size: 0.9rem; }

  /* Mobiel menu zonder JavaScript: een checkbox stuurt de navigatie aan. */
  .menu-schakelaar { position: absolute; opacity: 0; pointer-events: none; }
  .menu-knop { display: none; }

  @media (max-width: 900px) {
    .menu-knop {
      /* Erfde sinds de omslag naar licht de donkere bodytekst, terwijl deze
         knop op de donkere balk staat. */
      color: var(--tekst);
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      min-height: 2.75rem;
      padding: 0.5rem 0.9rem;
      border: 1px solid var(--rand-fel);
      border-radius: var(--hoek);
      font-family: 'Manrope', system-ui, sans-serif;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      user-select: none;
    }
    .menu-streep {
      width: 1rem;
      height: 2px;
      background: currentColor;
      box-shadow: 0 -5px 0 currentColor, 0 5px 0 currentColor;
    }
    .menu-label-dicht { display: none; }

    .navigatie {
      position: absolute;
      inset: 100% 0 auto 0;
      display: grid;
      gap: 0.25rem;
      padding: 1rem clamp(0.875rem, 4vw, 1.25rem) 1.5rem;
      /* Het uitklapmenu hoort bij de donkere balk, niet bij de lichte pagina.
         Met --mist-50 stond hier lichtgrijze tekst op bijna wit; de
         contrastcontrole zag dat niet, omdat het menu dichtgeklapt op
         visibility: hidden staat. */
      background: var(--inkt-950);
      border-bottom: 1px solid var(--rand);
      /* Zonder :checked onbereikbaar houden voor toetsenbord en voorlezer */
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity 180ms, transform 180ms, visibility 180ms;
    }
    .navigatie ul { display: grid; gap: 0.15rem; }
    .navigatie a:not(.knop) { padding: 0.8rem 0.6rem; font-size: 1.05rem; }
    .navigatie a:not(.knop)::after { bottom: 0.55rem; }
    .kop-knop { margin-top: 0.6rem; width: 100%; }

    .menu-schakelaar:checked ~ .navigatie {
      visibility: visible;
      opacity: 1;
      transform: none;
    }
    .menu-schakelaar:checked ~ .menu-knop .menu-label-open { display: none; }
    .menu-schakelaar:checked ~ .menu-knop .menu-label-dicht { display: inline; }
    .menu-schakelaar:checked ~ .menu-knop .menu-streep { box-shadow: none; }
    .menu-schakelaar:focus-visible ~ .menu-knop {
      outline: 3px solid var(--focus);
      outline-offset: 3px;
    }
  }
</style>

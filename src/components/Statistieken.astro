---
/**
 * De cijferbalk. Alle getallen worden geteld uit de content, nooit
 * met de hand ingevuld — zo kunnen ze niet verouderen.
 *
 * De teller loopt van nul naar de eindwaarde zodra de balk in beeld komt,
 * met @property en animation-timeline. Zonder ondersteuning of bij
 * prefers-reduced-motion staat het getal er meteen goed.
 */
interface Props {
  cijfers: { waarde: number; label: string; achtervoegsel?: string }[];
}
const { cijfers } = Astro.props;
---

<div class="cijferbalk">
  {cijfers.map((c, i) => (
    <div class="cijfer" style={`--eind:${c.waarde}; --vertraging:${i * 90}ms`}>
      <p class="cijfer-getal">
        <span class="teller" aria-hidden="true"></span>
        <span class="alleen-voorlezer">{c.waarde}</span>
        {c.achtervoegsel && <span class="achtervoegsel">{c.achtervoegsel}</span>}
      </p>
      <p class="cijfer-label">{c.label}</p>
    </div>
  ))}
</div>

<style>
  @property --n {
    syntax: '<integer>';
    inherits: false;
    initial-value: 0;
  }

  .cijferbalk {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: 1px;
    background: var(--rand);
    border: 1px solid var(--rand);
    border-radius: var(--hoek);
    overflow: hidden;
  }

  .cijfer {
    background: var(--inkt-900);
    padding: clamp(1.25rem, 1rem + 1vw, 2rem) clamp(1rem, 0.8rem + 0.8vw, 1.5rem);
    display: grid;
    gap: 0.3rem;
  }

  .cijfer-getal {
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: clamp(2.4rem, 1.6rem + 2.6vw, 3.6rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    background: var(--verloop-tekst);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    display: flex;
    align-items: baseline;
    gap: 0.1em;
  }

  /* Terugval: als counter() of animation-timeline ontbreekt, toont
     de teller alsnog de eindwaarde in plaats van niets. */
  .teller { counter-reset: n var(--eind); }
  .teller::after { content: counter(n); }

  .achtervoegsel { font-size: 0.45em; font-weight: 600; }

  .cijfer-label {
    font-size: 0.9rem;
    line-height: 1.35;
    color: var(--tekst-gedempt);
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .teller {
        counter-reset: n var(--n);
        animation: tel linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 34%;
      }
      @keyframes tel {
        from { --n: 0; }
        to   { --n: var(--eind); }
      }
    }
  }

  :global(.op-licht) .cijfer,
  :global(.op-wit) .cijfer { background: var(--wit); }
  :global(.op-licht) .cijferbalk,
  :global(.op-wit) .cijferbalk { background: var(--rand-licht); border-color: var(--rand-licht); }
  :global(.op-licht) .cijfer-label,
  :global(.op-wit) .cijfer-label { color: var(--tekst-donker-zacht); }
</style>
